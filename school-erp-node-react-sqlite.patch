@@ -0,0 +1,150 @@
+import cron from 'node-cron';
+import fs from 'node:fs';
+import path from 'node:path';
+import { db, get, all, run, getSetting } from '../db/index.js';
+import { config } from '../config.js';
+import { today, addDays, money } from '../utils/http.js';
+import { notify, notifyFamily, notifyAdmins, classTeacherOf } from '../utils/notify.js';
+import { recalcInvoice } from '../utils/billing.js';
+import { generatePayroll } from '../routes/hr.js';
+
+/**
+ * Every background job: id -> { schedule (cron), title, description, fn }
+ * Jobs are idempotent (safe to run twice) and every run is recorded in cron_runs.
+ */
+export const JOBS = {
+  'fee-reminders': {
+    schedule: '0 8 * * *', title: 'Fee due-date reminders',
+    description: 'Notifies parents N days before the due date, on the due date, and weekly while overdue (once per invoice per day).',
+    fn() {
+      const before = Number(getSetting('reminder_days_before', '3'));
+      const t = today(); let sent = 0;
+      for (const i of all(`SELECT i.id, i.student_id, i.invoice_no, i.due_date, i.reminder_sent_on, b.balance, i.description FROM invoices i JOIN v_invoice_balance b ON b.invoice_id = i.id
+          JOIN students s ON s.id = i.student_id WHERE i.status IN ('unpaid','partial') AND s.status = 'active' AND (i.reminder_sent_on IS NULL OR i.reminder_sent_on <> ?)`, t)) {
+        const days = Math.round((Date.parse(i.due_date) - Date.parse(t)) / 86400000);
+        let msg = null;
+        if (days === before) msg = `Due in ${before} days (${i.due_date})`;
+        else if (days === 0) msg = 'Due today';
+        else if (days < 0 && (-days) % 7 === 0) msg = `Overdue by ${-days} days`;
+        if (!msg) continue;
+        notifyFamily(i.student_id, { title: `Fee reminder: ${i.description}`, body: `${msg}. Balance ${money(i.balance)} (${i.invoice_no}).`, kind: 'fee', link: '/fees' });
+        // SMS mirror for parents only
+        for (const p of all('SELECT u.mobile FROM parent_students ps JOIN users u ON u.id = ps.parent_user_id WHERE ps.student_id = ? AND u.mobile IS NOT NULL', i.student_id))
+          run("INSERT INTO outbox(channel, to_addr, subject, body) VALUES ('sms', ?, ?, ?)", p.mobile, 'Fee reminder', `${i.description}: ${msg}. Balance ${money(i.balance)}`);
+        run('UPDATE invoices SET reminder_sent_on = ? WHERE id = ?', t, i.id); sent++;
+      }
+      return `${sent} reminder(s) sent`;
+    },
+  },
+  'late-fees': {
+    schedule: '10 0 * * *', title: 'Apply late fees',
+    description: 'Adds the configured late-fee % once to invoices that are past their due date. Admin-waived late fees are never re-applied.',
+    fn() {
+      const global = Number(getSetting('late_fee_percent', '0')); let n = 0;
+      db.transaction(() => {
+        for (const i of all(`SELECT i.id, i.student_id, i.invoice_no, i.amount, i.discount, f.late_fee_percent AS pct FROM invoices i LEFT JOIN fee_structures f ON f.id = i.structure_id
+            WHERE i.status IN ('unpaid','partial') AND i.due_date < date('now') AND i.late_fee = 0 AND i.late_fee_waived = 0`)) {
+          const pct = i.pct ?? global; if (!pct) continue;
+          const fee = money(((i.amount - i.discount) * pct) / 100); if (fee <= 0) continue;
+          run('UPDATE invoices SET late_fee = ? WHERE id = ?', fee, i.id); recalcInvoice(i.id);
+          notifyFamily(i.student_id, { title: 'Late fee added', body: `${fee} late fee added to ${i.invoice_no}.`, kind: 'fee', link: '/fees' }); n++;
+        }
+      })();
+      return `${n} late fee(s) applied`;
+    },
+  },
+  'attendance-reminder': {
+    schedule: '30 11 * * 1-6', title: 'Attendance not-marked reminder',
+    description: 'Reminds class teachers who have not marked attendance by 11:30 (skips holidays).',
+    fn() {
+      const t = today();
+      if (get("SELECT 1 x FROM announcements WHERE kind='holiday' AND ? BETWEEN start_date AND COALESCE(end_date, start_date)", t)) return 'holiday - skipped';
+      let n = 0;
+      for (const c of all(`SELECT c.id, c.name || '-' || c.section AS label, c.class_teacher_id FROM classes c WHERE c.class_teacher_id IS NOT NULL
+         AND EXISTS (SELECT 1 FROM students s WHERE s.class_id = c.id AND s.status='active') AND NOT EXISTS (SELECT 1 FROM attendance a WHERE a.class_id = c.id AND a.date = ? AND a.status <> 'L')`, t)) {
+        notify(c.class_teacher_id, { title: 'Attendance pending', body: `Please mark today's attendance for ${c.label}.`, kind: 'attendance', link: '/attendance' }); n++;
+      }
+      return `${n} teacher(s) reminded`;
+    },
+  },
+  'payroll-draft': {
+    schedule: '0 1 1 * *', title: 'Draft last month\'s payroll',
+    description: 'On the 1st of every month creates a DRAFT payroll run for the previous month from salary structures and staff attendance.',
+    fn() {
+      const d = new Date(); d.setUTCDate(1); d.setUTCMonth(d.getUTCMonth() - 1); const month = d.toISOString().slice(0, 7);
+      try { const out = generatePayroll(month, null); notifyAdmins({ title: 'Payroll draft ready', body: `Draft payroll for ${month} has been generated. Review and finalize.`, kind: 'payroll', link: '/hr/payroll' }); return `${month}: ${out.created} payslip(s) drafted`; }
+      catch (e) { if (e.status === 409) return `${month}: already processed`; throw e; }
+    },
+  },
+  'db-backup': {
+    schedule: '30 2 * * *', title: 'Database backup',
+    description: 'Takes a consistent online SQLite backup and keeps the latest 7.',
+    async fn() {
+      if (config.dbPath === ':memory:') return 'in-memory database - skipped';
+      fs.mkdirSync(config.backupDir, { recursive: true });
+      const name = `school-${new Date().toISOString().replace(/[:T]/g, '-').slice(0, 19)}.db`;
+      await db.backup(path.join(config.backupDir, name));
+      const files = fs.readdirSync(config.backupDir).filter((f) => f.endsWith('.db')).sort();
+      for (const f of files.slice(0, Math.max(0, files.length - 7))) fs.rmSync(path.join(config.backupDir, f), { force: true });
+      return `saved ${name}`;
+    },
+  },
+  'expiry-alerts': {
+    schedule: '0 9 * * 1', title: 'Licence & vehicle expiry alerts',
+    description: 'Every Monday warns admins about driver licences, vehicle insurance and fitness certificates expiring within 30 days.',
+    fn() {
+      const lim = addDays(today(), 30); const items = [];
+      for (const e of all("SELECT name, license_expiry d FROM employees WHERE status='active' AND license_expiry IS NOT NULL AND license_expiry <= ?", lim)) items.push(`Licence - ${e.name}: ${e.d}`);
+      for (const v of all("SELECT reg_no, insurance_expiry, fitness_expiry FROM vehicles WHERE status <> 'inactive'")) {
+        if (v.insurance_expiry && v.insurance_expiry <= lim) items.push(`Insurance - ${v.reg_no}: ${v.insurance_expiry}`);
+        if (v.fitness_expiry && v.fitness_expiry <= lim) items.push(`Fitness - ${v.reg_no}: ${v.fitness_expiry}`);
+      }
+      if (items.length) notifyAdmins({ title: `${items.length} transport document(s) expiring soon`, body: items.slice(0, 6).join('; '), kind: 'transport', link: '/transport' });
+      return `${items.length} item(s) flagged`;
+    },
+  },
+  maintenance: {
+    schedule: '0 3 * * 0', title: 'Database maintenance',
+    description: 'Prunes old GPS history (7 days), read notifications (90 days), old outbox/job logs, then optimizes SQLite.',
+    fn() {
+      const a = run("DELETE FROM bus_location_history WHERE ts < datetime('now','-7 days')").changes;
+      const b = run("DELETE FROM notifications WHERE is_read = 1 AND created_at < datetime('now','-90 days')").changes;
+      const c = run("DELETE FROM outbox WHERE created_at < datetime('now','-60 days')").changes;
+      const d = run("DELETE FROM cron_runs WHERE started_at < datetime('now','-60 days')").changes;
+      db.pragma('wal_checkpoint(TRUNCATE)'); db.pragma('optimize');
+      return `pruned ${a} GPS, ${b} notifications, ${c} outbox, ${d} job logs`;
+    },
+  },
+};
+
+export async function runJob(name, trigger = 'cron') {
+  const job = JOBS[name]; if (!job) throw new Error(`unknown job ${name}`);
+  const id = run('INSERT INTO cron_runs(job) VALUES (?)', name).lastInsertRowid;
+  try {
+    const message = await job.fn();
+    run("UPDATE cron_runs SET status='ok', finished_at=datetime('now'), message=? WHERE id=?", `${message}${trigger === 'manual' ? ' (manual)' : ''}`, id);
+    return { job: name, status: 'ok', message };
+  } catch (e) {
+    console.error(`[cron] ${name} failed:`, e);
+    run("UPDATE cron_runs SET status='error', finished_at=datetime('now'), message=? WHERE id=?", String(e.message).slice(0, 300), id);
+    return { job: name, status: 'error', message: e.message };
+  }
+}
+
+export function jobStatus() {
+  return Object.entries(JOBS).map(([name, j]) => ({
+    name, title: j.title, description: j.description, schedule: j.schedule,
+    last_run: get('SELECT started_at, finished_at, status, message FROM cron_runs WHERE job = ? ORDER BY id DESC LIMIT 1', name) || null,
+    runs: all('SELECT started_at, status, message FROM cron_runs WHERE job = ? ORDER BY id DESC LIMIT 5', name),
+  }));
+}
+
+export function startCron() {
+  if (!config.enableCron) { console.log('[cron] disabled (ENABLE_CRON=0)'); return []; }
+  const tz = process.env.TZ || undefined;
+  const tasks = Object.entries(JOBS).map(([name, j]) => cron.schedule(j.schedule, () => { runJob(name); }, { timezone: tz }));
+  // anything left "running" by a crash is closed out
+  run("UPDATE cron_runs SET status='error', finished_at=datetime('now'), message='interrupted by restart' WHERE status='running'");
+  console.log(`[cron] ${tasks.length} jobs scheduled`);
+  return tasks;
+}
diff --git a/server/src/middleware/auth.js b/server/src/middleware/auth.js
new file mode 100644
index 0000000..1ac13d8
--- /dev/null
+++ b/server/src/middleware/auth.js
@@ -0,0 +1,53 @@
+import jwt from 'jsonwebtoken';
+import { config } from '../config.js';
+import { get } from '../db/index.js';
+import { unauthorized, forbidden, HttpError } from '../utils/http.js';
+
+export function signToken(user) {
+  return jwt.sign({ sub: user.id, v: user.token_version }, config.jwtSecret, { expiresIn: config.jwtExpiresIn });
+}
+
+/**
+ * Verifies the JWT AND re-reads the user row on every request. A deactivated / rejected account,
+ * or a bumped token_version (password reset, forced logout), is therefore locked out immediately.
+ */
+export function authenticate(req, _res, next) {
+  const h = req.headers.authorization || '';
+  const token = h.startsWith('Bearer ') ? h.slice(7) : req.query.token;
+  if (!token) return next(unauthorized());
+  let payload;
+  try { payload = jwt.verify(token, config.jwtSecret); } catch { return next(unauthorized('Session expired, please sign in again')); }
+  const u = get('SELECT id, name, email, mobile, role, status, must_change_password, token_version FROM users WHERE id = ?', payload.sub);
+  if (!u || u.token_version !== payload.v) return next(unauthorized('Session expired, please sign in again'));
+  if (u.status !== 'active') return next(forbidden(`Your account is ${u.status}. Please contact the school office.`));
+  req.user = u;
+  next();
+}
+
+export const requireRole = (...roles) => (req, _res, next) =>
+  roles.includes(req.user?.role) ? next() : next(forbidden());
+
+export function errorHandler(err, _req, res, _next) {
+  if (err instanceof HttpError) return res.status(err.status).json({ error: err.message, ...(err.extra ? { details: err.extra } : {}) });
+  if (err?.code === 'SQLITE_CONSTRAINT_UNIQUE' || err?.code === 'SQLITE_CONSTRAINT_PRIMARYKEY') {
+    return res.status(409).json({ error: friendlyConstraint(err.message) });
+  }
+  if (err?.code?.startsWith?.('SQLITE_CONSTRAINT')) {
+    return res.status(400).json({ error: err.code === 'SQLITE_CONSTRAINT_TRIGGER' ? err.message : friendlyConstraint(err.message) });
+  }
+  if (err?.code === 'LIMIT_FILE_SIZE') return res.status(413).json({ error: 'File is too large (max 10 MB)' });
+  if (err?.type === 'entity.parse.failed') return res.status(400).json({ error: 'Invalid JSON body' });
+  console.error(err);
+  res.status(500).json({ error: config.isProd ? 'Internal server error' : err.message });
+}
+
+function friendlyConstraint(msg = '') {
+  if (msg.includes('students.mobile, students.name')) return 'A student with this name and mobile number already exists';
+  if (msg.includes('students.admission_no')) return 'Admission number already exists';
+  if (msg.includes('users.email')) return 'This email is already registered';
+  if (msg.includes('users.mobile')) return 'This mobile number is already registered';
+  if (msg.includes('FOREIGN KEY')) return 'This record is linked to other data and cannot be changed this way';
+  if (msg.includes('CHECK')) return 'One of the values is not allowed';
+  const m = msg.match(/UNIQUE constraint failed: ([\w.]+)/);
+  return m ? `Duplicate value for ${m[1].split('.').pop().replace(/_/g, ' ')}` : 'Duplicate or invalid value';
+}
diff --git a/server/src/routes/academic.js b/server/src/routes/academic.js
new file mode 100644
index 0000000..e581cfb
--- /dev/null
+++ b/server/src/routes/academic.js
@@ -0,0 +1,168 @@
+import { Router } from 'express';
+import { get, all, run, tx } from '../db/index.js';
+import { ah, bad, notFound, conflict, str, int, oneOf, flag } from '../utils/http.js';
+import { authenticate, requireRole } from '../middleware/auth.js';
+import { audit } from '../utils/audit.js';
+import { childIds, teacherClasses } from '../utils/access.js';
+import { generateTimetable } from '../utils/timetable.js';
+
+const r = Router();
+r.use(authenticate);
+
+// ------------------------------------------------------------------ classes
+r.get('/classes', ah((req, res) => {
+  let where = '1=1'; const p = [];
+  if (req.user.role === 'parent' || req.user.role === 'student') {
+    const ids = childIds(req.user);
+    where = `c.id IN (SELECT class_id FROM students WHERE id IN (${ids.map(() => '?').join(',') || 'NULL'}))`; p.push(...ids);
+  } else if (req.user.role === 'driver') where = '0=1';
+  const rows = all(`SELECT c.id, c.name, c.section, c.name || '-' || c.section AS label, c.room, c.capacity, c.class_teacher_id,
+    u.name AS class_teacher, (SELECT COUNT(*) FROM students s WHERE s.class_id = c.id AND s.status='active') AS students
+    FROM classes c LEFT JOIN users u ON u.id = c.class_teacher_id WHERE ${where} ORDER BY c.name, c.section`, ...p);
+  if (req.user.role === 'teacher' && req.query.mine) {
+    const mine = teacherClasses(req.user.id);
+    return res.json({ rows: rows.filter((c) => mine.all.includes(c.id)).map((c) => ({ ...c, is_ct: mine.ct.includes(c.id) })) });
+  }
+  res.json({ rows });
+}));
+
+function classBody(b, ex = {}) {
+  const name = str(b.name ?? ex.name, 'Class name', { max: 30 });
+  const section = str(b.section ?? ex.section ?? 'A', 'Section', { max: 10 });
+  const ct = int(b.class_teacher_id === '' ? null : (b.class_teacher_id ?? ex.class_teacher_id), 'class teacher', { required: false });
+  if (ct && !get("SELECT id FROM users WHERE id = ? AND role = 'teacher' AND status = 'active'", ct)) throw bad('Class teacher must be an active teacher account');
+  return { name, section, ct, room: str(b.room ?? ex.room, 'room', { required: false, max: 30 }), capacity: int(b.capacity ?? ex.capacity ?? 40, 'capacity', { min: 1, max: 200 }) };
+}
+r.post('/classes', requireRole('admin'), ah((req, res) => {
+  const v = classBody(req.body);
+  const id = run('INSERT INTO classes(name, section, class_teacher_id, room, capacity) VALUES (?,?,?,?,?)', v.name, v.section, v.ct, v.room, v.capacity).lastInsertRowid;
+  audit(req, 'create_class', 'class', id); res.status(201).json({ id });
+}));
+r.put('/classes/:id', requireRole('admin'), ah((req, res) => {
+  const ex = get('SELECT * FROM classes WHERE id = ?', req.params.id); if (!ex) throw notFound();
+  const v = classBody(req.body, ex);
+  run('UPDATE classes SET name=?, section=?, class_teacher_id=?, room=?, capacity=? WHERE id=?', v.name, v.section, v.ct, v.room, v.capacity, ex.id);
+  audit(req, 'update_class', 'class', ex.id, { class_teacher_id: v.ct }); res.json({ ok: true });
+}));
+r.delete('/classes/:id', requireRole('admin'), ah((req, res) => {
+  if (get('SELECT 1 x FROM students WHERE class_id = ?', req.params.id)) throw conflict('Move or remove the students of this class first');
+  run('DELETE FROM classes WHERE id = ?', req.params.id); audit(req, 'delete_class', 'class', req.params.id); res.json({ ok: true });
+}));
+
+// ----------------------------------------------------------------- subjects
+r.get('/subjects', ah((_req, res) => res.json({ rows: all('SELECT * FROM subjects ORDER BY name') })));
+r.post('/subjects', requireRole('admin'), ah((req, res) => {
+  const id = run('INSERT INTO subjects(name, code) VALUES (?,?)', str(req.body.name, 'Name', { max: 60 }), str(req.body.code, 'Code', { max: 12 }).toUpperCase()).lastInsertRowid;
+  res.status(201).json({ id });
+}));
+r.put('/subjects/:id', requireRole('admin'), ah((req, res) => {
+  run('UPDATE subjects SET name = ?, code = ? WHERE id = ?', str(req.body.name, 'Name', { max: 60 }), str(req.body.code, 'Code', { max: 12 }).toUpperCase(), req.params.id);
+  res.json({ ok: true });
+}));
+r.delete('/subjects/:id', requireRole('admin'), ah((req, res) => {
+  if (get('SELECT 1 x FROM marks WHERE subject_id = ?', req.params.id)) throw conflict('Marks exist for this subject');
+  run('DELETE FROM subjects WHERE id = ?', req.params.id); res.json({ ok: true });
+}));
+
+r.get('/classes/:id/subjects', ah((req, res) => {
+  res.json({ rows: all(`SELECT cs.id, cs.subject_id, s.name AS subject, s.code, cs.teacher_id, u.name AS teacher, cs.periods_per_week
+    FROM class_subjects cs JOIN subjects s ON s.id = cs.subject_id LEFT JOIN users u ON u.id = cs.teacher_id
+    WHERE cs.class_id = ? ORDER BY s.name`, req.params.id) });
+}));
+r.put('/classes/:id/subjects', requireRole('admin'), ah((req, res) => {
+  const cid = int(req.params.id, 'class');
+  if (!get('SELECT id FROM classes WHERE id = ?', cid)) throw notFound('Class not found');
+  const list = Array.isArray(req.body.subjects) ? req.body.subjects : [];
+  tx(() => {
+    run('DELETE FROM class_subjects WHERE class_id = ?', cid);
+    for (const s of list) {
+      const tid = int(s.teacher_id || null, 'teacher', { required: false });
+      if (tid && !get("SELECT 1 x FROM users WHERE id = ? AND role = 'teacher'", tid)) throw bad('Teacher not found');
+      run('INSERT INTO class_subjects(class_id, subject_id, teacher_id, periods_per_week) VALUES (?,?,?,?)',
+        cid, int(s.subject_id, 'subject'), tid, int(s.periods_per_week ?? 4, 'periods per week', { min: 0, max: 12 }));
+    }
+  });
+  audit(req, 'set_class_subjects', 'class', cid, { count: list.length });
+  res.json({ ok: true });
+}));
+
+// ------------------------------------------------------------------ periods
+r.get('/periods', ah((_req, res) => res.json({ rows: all('SELECT * FROM periods ORDER BY seq') })));
+function periodBody(b) {
+  const t = /^([01]\d|2[0-3]):[0-5]\d$/;
+  const start = str(b.start_time, 'Start time'), end = str(b.end_time, 'End time');
+  if (!t.test(start) || !t.test(end) || end <= start) throw bad('Enter valid start/end times (HH:MM) with end after start');
+  return [str(b.name, 'Name', { max: 30 }), int(b.seq, 'Order', { min: 1, max: 20 }), start, end, flag(b.is_break)];
+}
+r.post('/periods', requireRole('admin'), ah((req, res) => {
+  const id = run('INSERT INTO periods(name, seq, start_time, end_time, is_break) VALUES (?,?,?,?,?)', ...periodBody(req.body)).lastInsertRowid; res.status(201).json({ id });
+}));
+r.put('/periods/:id', requireRole('admin'), ah((req, res) => {
+  run('UPDATE periods SET name=?, seq=?, start_time=?, end_time=?, is_break=? WHERE id=?', ...periodBody(req.body), req.params.id); res.json({ ok: true });
+}));
+r.delete('/periods/:id', requireRole('admin'), ah((req, res) => { run('DELETE FROM periods WHERE id = ?', req.params.id); res.json({ ok: true }); }));
+
+// ---------------------------------------------------------------- timetable
+const TT = `SELECT t.id, t.class_id, t.day, t.period_id, t.subject_id, t.teacher_id, s.name AS subject, s.code, u.name AS teacher,
+  c.name || '-' || c.section AS class_label FROM timetable t JOIN subjects s ON s.id = t.subject_id
+  JOIN classes c ON c.id = t.class_id LEFT JOIN users u ON u.id = t.teacher_id`;
+
+r.get('/timetable', ah((req, res) => {
+  const { role, id } = req.user;
+  let rows;
+  if (req.query.teacher === 'me' || (role === 'teacher' && !req.query.class_id)) rows = all(`${TT} WHERE t.teacher_id = ?`, id);
+  else {
+    let cid = int(req.query.class_id, 'class_id', { required: false });
+    if (role === 'parent' || role === 'student') {
+      const kids = childIds(req.user);
+      const cls = all(`SELECT DISTINCT class_id FROM students WHERE id IN (${kids.map(() => '?').join(',') || 'NULL'})`, ...kids).map((x) => x.class_id);
+      if (!cid) cid = cls[0];
+      if (!cls.includes(cid)) throw bad('Class not available');
+    }
+    if (!cid) throw bad('class_id is required');
+    rows = all(`${TT} WHERE t.class_id = ?`, cid);
+  }
+  res.json({ rows, periods: all('SELECT * FROM periods ORDER BY seq') });
+}));
+
+r.post('/timetable/generate', requireRole('admin'), ah((req, res) => {
+  const days = int(req.body.days ?? 5, 'days', { min: 5, max: 6 });
+  const apply = !!req.body.apply;
+  const ids = Array.isArray(req.body.class_ids) && req.body.class_ids.length ? req.body.class_ids.map(Number) : all('SELECT id FROM classes').map((c) => c.id);
+  const periods = all('SELECT * FROM periods WHERE is_break = 0 ORDER BY seq');
+  if (!periods.length) throw bad('Define at least one teaching period first');
+  const classes = ids.map((cid) => ({
+    id: cid, subjects: all('SELECT subject_id, teacher_id, periods_per_week FROM class_subjects WHERE class_id = ?', cid),
+  })).filter((c) => c.subjects.length);
+  if (!classes.length) throw bad('Assign subjects (with periods per week) to the classes first');
+  // teachers already booked by classes we are NOT regenerating
+  const busy = new Set(all(`SELECT teacher_id, day, period_id FROM timetable WHERE teacher_id IS NOT NULL AND class_id NOT IN (${ids.map(() => '?').join(',')})`, ...ids)
+    .map((x) => `${x.teacher_id}:${x.day}:${x.period_id}`));
+  const { entries, unplaced } = generateTimetable({ classes, periods, days, busy });
+  if (apply) {
+    tx(() => {
+      for (const c of classes) run('DELETE FROM timetable WHERE class_id = ?', c.id);
+      for (const e of entries) run('INSERT INTO timetable(class_id, day, period_id, subject_id, teacher_id) VALUES (?,?,?,?,?)', e.class_id, e.day, e.period_id, e.subject_id, e.teacher_id);
+    });
+    audit(req, 'generate_timetable', 'timetable', null, { classes: classes.length, lessons: entries.length, unplaced: unplaced.length });
+  }
+  res.json({ applied: apply, lessons: entries.length, classes: classes.length, unplaced, entries: apply ? undefined : entries });
+}));
+
+r.put('/timetable/slot', requireRole('admin'), ah((req, res) => {
+  const cid = int(req.body.class_id, 'class'), day = int(req.body.day, 'day', { min: 1, max: 6 }), pid = int(req.body.period_id, 'period'), sid = int(req.body.subject_id, 'subject');
+  const tid = get('SELECT teacher_id FROM class_subjects WHERE class_id = ? AND subject_id = ?', cid, sid)?.teacher_id ?? null;
+  if (tid) {
+    const clash = get('SELECT c.name || \'-\' || c.section AS cls FROM timetable t JOIN classes c ON c.id = t.class_id WHERE t.teacher_id = ? AND t.day = ? AND t.period_id = ? AND t.class_id <> ?', tid, day, pid, cid);
+    if (clash) throw conflict(`Teacher is already teaching ${clash.cls} in that period`);
+  }
+  run(`INSERT INTO timetable(class_id, day, period_id, subject_id, teacher_id) VALUES (?,?,?,?,?)
+       ON CONFLICT(class_id, day, period_id) DO UPDATE SET subject_id = excluded.subject_id, teacher_id = excluded.teacher_id`, cid, day, pid, sid, tid);
+  audit(req, 'edit_timetable_slot', 'class', cid); res.json({ ok: true });
+}));
+r.delete('/timetable/slot', requireRole('admin'), ah((req, res) => {
+  run('DELETE FROM timetable WHERE class_id = ? AND day = ? AND period_id = ?', int(req.query.class_id, 'class'), int(req.query.day, 'day'), int(req.query.period_id, 'period'));
+  res.json({ ok: true });
+}));
+
+export default r;
diff --git a/server/src/routes/attendance.js b/server/src/routes/attendance.js
new file mode 100644
index 0000000..3882e50
--- /dev/null
+++ b/server/src/routes/attendance.js
@@ -0,0 +1,83 @@
+import { Router } from 'express';
+import { get, all, run, tx } from '../db/index.js';
+import { ah, bad, forbidden, date, today, addDays, int, oneOf } from '../utils/http.js';
+import { authenticate, requireRole } from '../middleware/auth.js';
+import { audit } from '../utils/audit.js';
+import { notifyFamily } from '../utils/notify.js';
+import { studentAccess, ownClassOrAdmin } from '../utils/access.js';
+import { sendRows } from '../utils/csv.js';
+
+const r = Router();
+r.use(authenticate);
+
+// Class roster for a date (CT / admin mark; subject teachers read-only)
+r.get('/class/:classId', requireRole('admin', 'teacher'), ah((req, res) => {
+  const level = ownClassOrAdmin(req.user, req.params.classId);
+  const d = date(req.query.date || today(), 'date');
+  const rows = all(`SELECT s.id AS student_id, s.name, s.roll_no, s.admission_no, a.status, a.note,
+      EXISTS(SELECT 1 FROM leaves l WHERE l.student_id = s.id AND l.status = 'approved' AND ? BETWEEN l.from_date AND l.to_date) AS on_approved_leave
+    FROM students s LEFT JOIN attendance a ON a.student_id = s.id AND a.date = ?
+    WHERE s.class_id = ? AND s.status = 'active' ORDER BY s.roll_no, s.name`, d, d, req.params.classId);
+  res.json({ date: d, can_mark: level === 'admin' || level === 'ct', marked: rows.some((x) => x.status), rows });
+}));
+
+r.post('/class/:classId', requireRole('admin', 'teacher'), ah((req, res) => {
+  const cid = int(req.params.classId, 'class');
+  const level = ownClassOrAdmin(req.user, cid);
+  if (level === 'teacher') throw forbidden('Only the class teacher can mark attendance for this class');
+  const d = date(req.body.date, 'date');
+  if (d > today()) throw bad('Cannot mark attendance for a future date');
+  if (new Date(`${d}T00:00:00Z`).getUTCDay() === 0) throw bad('Sunday is not a school day');
+  const records = Array.isArray(req.body.records) ? req.body.records : [];
+  if (!records.length) throw bad('No records supplied');
+  const valid = new Set(all("SELECT id FROM students WHERE class_id = ? AND status = 'active'", cid).map((x) => x.id));
+  const newlyAbsent = [];
+  tx(() => {
+    for (const rec of records) {
+      const sid = int(rec.student_id, 'student_id');
+      if (!valid.has(sid)) throw bad(`Student ${sid} is not an active student of this class`);
+      const st = oneOf(rec.status, ['P', 'A', 'L'], 'status');
+      const prev = get('SELECT status FROM attendance WHERE student_id = ? AND date = ?', sid, d)?.status;
+      run(`INSERT INTO attendance(student_id, class_id, date, status, note, marked_by) VALUES (?,?,?,?,?,?)
+           ON CONFLICT(student_id, date) DO UPDATE SET status = excluded.status, note = excluded.note, marked_by = excluded.marked_by, class_id = excluded.class_id`,
+      sid, cid, d, st, rec.note ? String(rec.note).slice(0, 200) : null, req.user.id);
+      if (st === 'A' && prev !== 'A') newlyAbsent.push(sid);
+    }
+  });
+  for (const sid of newlyAbsent) {
+    const s = get('SELECT name FROM students WHERE id = ?', sid);
+    notifyFamily(sid, { title: 'Absent today', body: `${s.name} was marked absent on ${d}.`, kind: 'attendance', link: '/attendance', sms: true });
+  }
+  audit(req, 'mark_attendance', 'class', cid, { date: d, count: records.length });
+  res.json({ ok: true, saved: records.length, absent_alerts: newlyAbsent.length });
+}));
+
+// A student's attendance - defaults to the last 3 months
+r.get('/student/:id', ah((req, res) => {
+  const { student } = studentAccess(req.user, req.params.id);
+  const to = date(req.query.to || today(), 'to');
+  const from = date(req.query.from || addDays(to, -92), 'from');
+  const records = all('SELECT date, status, note FROM attendance WHERE student_id = ? AND date BETWEEN ? AND ? ORDER BY date DESC', student.id, from, to);
+  const summary = get(`SELECT COALESCE(SUM(status='P'),0) present, COALESCE(SUM(status='A'),0) absent, COALESCE(SUM(status='L'),0) on_leave, COUNT(*) total
+     FROM attendance WHERE student_id = ? AND date BETWEEN ? AND ?`, student.id, from, to);
+  const counted = summary.present + summary.absent;
+  const monthly = all(`SELECT substr(date,1,7) month, SUM(status='P') present, SUM(status='A') absent, SUM(status='L') on_leave
+     FROM attendance WHERE student_id = ? AND date BETWEEN ? AND ? GROUP BY 1 ORDER BY 1`, student.id, from, to);
+  res.json({ from, to, summary: { ...summary, percent: counted ? Math.round((summary.present / counted) * 1000) / 10 : null }, monthly, records });
+}));
+
+// Per-student % for a class over a range (admin / teachers of the class)
+r.get('/report', requireRole('admin', 'teacher'), ah((req, res) => {
+  const cid = int(req.query.class_id, 'class_id');
+  ownClassOrAdmin(req.user, cid);
+  const to = date(req.query.to || today(), 'to');
+  const from = date(req.query.from || addDays(to, -30), 'from');
+  const rows = all(`SELECT s.id AS student_id, s.roll_no, s.admission_no, s.name,
+      COALESCE(SUM(a.status='P'),0) AS present, COALESCE(SUM(a.status='A'),0) AS absent, COALESCE(SUM(a.status='L'),0) AS on_leave,
+      CASE WHEN SUM(a.status IN ('P','A')) > 0 THEN ROUND(100.0 * SUM(a.status='P') / SUM(a.status IN ('P','A')), 1) END AS percent
+    FROM students s LEFT JOIN attendance a ON a.student_id = s.id AND a.date BETWEEN ? AND ?
+    WHERE s.class_id = ? AND s.status = 'active' GROUP BY s.id ORDER BY s.roll_no, s.name`, from, to, cid);
+  return sendRows(req, res, rows, `attendance-${cid}-${from}-${to}`);
+}));
+
+export default r;
diff --git a/server/src/routes/auth.js b/server/src/routes/auth.js
new file mode 100644
index 0000000..9b2a4da
--- /dev/null
+++ b/server/src/routes/auth.js
@@ -0,0 +1,98 @@
+import { Router } from 'express';
+import bcrypt from 'bcryptjs';
+import crypto from 'node:crypto';
+import { get, run, all, tx } from '../db/index.js';
+import { ah, bad, str, mobile as vMobile, oneOf, unauthorized, forbidden } from '../utils/http.js';
+import { signToken, authenticate } from '../middleware/auth.js';
+import { audit } from '../utils/audit.js';
+import { notifyAdmins } from '../utils/notify.js';
+
+const r = Router();
+export const tempPassword = () => crypto.randomBytes(6).toString('base64url').slice(0, 9) + '#7';
+
+// naive in-memory throttle: 8 failures / 10 min per ip+identifier
+const fails = new Map();
+function throttled(key) {
+  const now = Date.now(); const e = fails.get(key);
+  if (!e || now - e.t > 600000) return false;
+  return e.n >= 8;
+}
+const markFail = (key) => { const now = Date.now(); const e = fails.get(key); fails.set(key, !e || now - e.t > 600000 ? { n: 1, t: now } : { n: e.n + 1, t: e.t }); };
+
+function findLoginUser(identifier) {
+  const id = identifier.trim();
+  let u = get('SELECT * FROM users WHERE email = ? COLLATE NOCASE', id) || get('SELECT * FROM users WHERE mobile = ?', id.replace(/[\s\-()]/g, ''));
+  if (!u) { // students sign in with their admission number
+    const s = get('SELECT user_id FROM students WHERE admission_no = ? COLLATE NOCASE', id);
+    if (s?.user_id) u = get('SELECT * FROM users WHERE id = ?', s.user_id);
+  }
+  return u;
+}
+
+export const publicUser = (u) => ({
+  id: u.id, name: u.name, email: u.email, mobile: u.mobile, role: u.role, status: u.status,
+  must_change_password: !!u.must_change_password,
+});
+
+r.post('/login', ah((req, res) => {
+  const identifier = str(req.body.identifier, 'Email / mobile / admission no', { max: 120 });
+  const password = str(req.body.password, 'Password', { max: 200 });
+  const key = `${req.ip}|${identifier.toLowerCase()}`;
+  if (throttled(key)) throw new (class extends Error { status = 429 })('Too many attempts. Try again in a few minutes.');
+  const u = findLoginUser(identifier);
+  if (!u || !bcrypt.compareSync(password, u.password_hash)) { markFail(key); throw unauthorized('Invalid credentials'); }
+  if (u.status === 'pending') throw forbidden('Your account is awaiting admin approval.');
+  if (u.status === 'rejected') throw forbidden('Your registration was not approved. Please contact the school.');
+  if (u.status === 'inactive') throw forbidden('Your account is deactivated. Please contact the school office.');
+  fails.delete(key);
+  run("UPDATE users SET last_login_at = datetime('now') WHERE id = ?", u.id);
+  audit({ user: u, ip: req.ip }, 'login', 'user', u.id);
+  res.json({ token: signToken(u), user: publicUser(u) });
+}));
+
+r.post('/register', ah((req, res) => {
+  const b = req.body;
+  const role = oneOf(b.role, ['parent', 'driver', 'teacher', 'finance'], 'role');
+  const name = str(b.name, 'Name', { max: 100 });
+  const email = str(b.email, 'Email', { required: false, max: 120 });
+  const mob = vMobile(b.mobile);
+  const password = str(b.password, 'Password', { min: 8, max: 100 });
+  if (email && !/^\S+@\S+\.\S+$/.test(email)) throw bad('Email is not valid');
+  const meta = role === 'parent' && Array.isArray(b.children)
+    ? JSON.stringify(b.children.slice(0, 6).map((c) => ({ admission_no: String(c.admission_no || '').trim(), relation: String(c.relation || 'guardian').slice(0, 20) })))
+    : null;
+  const info = run(
+    "INSERT INTO users(name, email, mobile, password_hash, role, status, meta) VALUES (?,?,?,?,?, 'pending', ?)",
+    name, email, mob, bcrypt.hashSync(password, 10), role, meta,
+  );
+  notifyAdmins({ title: 'New account awaiting approval', body: `${name} registered as ${role}.`, kind: 'approval', link: '/admin/approvals' });
+  audit({ user: { id: info.lastInsertRowid, name }, ip: req.ip }, 'register', 'user', info.lastInsertRowid, { role });
+  res.status(201).json({ message: 'Registration received. You can sign in once the school admin approves your account.' });
+}));
+
+r.get('/me', authenticate, ah((req, res) => {
+  const u = get('SELECT * FROM users WHERE id = ?', req.user.id);
+  const unread = get('SELECT COUNT(*) n FROM notifications WHERE user_id = ? AND is_read = 0', u.id).n;
+  res.json({ user: publicUser(u), unread });
+}));
+
+r.post('/change-password', authenticate, ah((req, res) => {
+  const cur = str(req.body.current_password, 'Current password');
+  const next = str(req.body.new_password, 'New password', { min: 8, max: 100 });
+  const u = get('SELECT * FROM users WHERE id = ?', req.user.id);
+  if (!bcrypt.compareSync(cur, u.password_hash)) throw bad('Current password is incorrect');
+  if (cur === next) throw bad('New password must be different');
+  run('UPDATE users SET password_hash = ?, must_change_password = 0, token_version = token_version + 1 WHERE id = ?', bcrypt.hashSync(next, 10), u.id);
+  const fresh = get('SELECT * FROM users WHERE id = ?', u.id);
+  audit(req, 'change_password', 'user', u.id);
+  res.json({ token: signToken(fresh), user: publicUser(fresh) });
+}));
+
+r.put('/profile', authenticate, ah((req, res) => {
+  const name = str(req.body.name, 'Name', { max: 100 });
+  const email = str(req.body.email, 'Email', { required: false, max: 120 });
+  run('UPDATE users SET name = ?, email = COALESCE(?, email) WHERE id = ?', name, email, req.user.id);
+  res.json({ user: publicUser(get('SELECT * FROM users WHERE id = ?', req.user.id)) });
+}));
+
+export default r;
diff --git a/server/src/routes/comms.js b/server/src/routes/comms.js
new file mode 100644
index 0000000..ef8e599
--- /dev/null
+++ b/server/src/routes/comms.js
@@ -0,0 +1,253 @@
+import { Router } from 'express';
+import { get, all, run, tx, nextSeq } from '../db/index.js';
+import { ah, bad, notFound, forbidden, conflict, str, int, date, oneOf, flag, today, addDays } from '../utils/http.js';
+import { authenticate, requireRole } from '../middleware/auth.js';
+import { audit } from '../utils/audit.js';
+import { notify, notifyAdmins, parentIdsOf, classTeacherOf } from '../utils/notify.js';
+import { childIds, teacherClasses, studentAccess, ownClassOrAdmin } from '../utils/access.js';
+
+const r = Router();
+r.use(authenticate);
+
+/** class ids a user belongs to (for audience filtering) */
+function myClassIds(user) {
+  if (user.role === 'teacher') return teacherClasses(user.id).all;
+  if (user.role === 'parent' || user.role === 'student') {
+    const kids = childIds(user);
+    return all(`SELECT DISTINCT class_id FROM students WHERE class_id IS NOT NULL AND id IN (${kids.map(() => '?').join(',') || 'NULL'})`, ...kids).map((x) => x.class_id);
+  }
+  return [];
+}
+const AUD = { admin: ['all', 'staff', 'parents', 'students', 'drivers', 'class'], teacher: ['all', 'staff', 'class'], finance: ['all', 'staff'], parent: ['all', 'parents'], student: ['all', 'students'], driver: ['all', 'drivers', 'staff'] };
+
+// ================================================================== NOTICES / EVENTS / HOLIDAYS
+const ANN = `SELECT a.*, u.name AS author, c.name || '-' || c.section AS class_label FROM announcements a LEFT JOIN users u ON u.id = a.created_by LEFT JOIN classes c ON c.id = a.class_id`;
+
+r.get('/announcements', ah((req, res) => {
+  const where = []; const p = [];
+  if (req.user.role !== 'admin') {
+    const aud = AUD[req.user.role].filter((x) => x !== 'class');
+    const cls = myClassIds(req.user);
+    where.push(`(a.audience IN (${aud.map(() => '?').join(',')}) OR (a.audience = 'class' AND a.class_id IN (${cls.map(() => '?').join(',') || 'NULL'})))`); p.push(...aud, ...cls);
+  }
+  if (req.query.kind) { where.push('a.kind = ?'); p.push(req.query.kind); }
+  if (req.query.active === '1') { where.push("COALESCE(a.end_date, a.start_date) >= date('now')"); }
+  res.json({ rows: all(`${ANN} ${where.length ? 'WHERE ' + where.join(' AND ') : ''} ORDER BY a.pinned DESC, a.start_date DESC, a.id DESC LIMIT 200`, ...p) });
+}));
+
+r.get('/calendar', ah((req, res) => {
+  const month = String(req.query.month || today().slice(0, 7));
+  if (!/^\d{4}-\d{2}$/.test(month)) throw bad('month must be YYYY-MM');
+  const first = `${month}-01`, last = addDays(`${new Date(Date.UTC(+month.slice(0, 4), +month.slice(5), 1)).toISOString().slice(0, 7)}-01`, -1);
+  const where = ["a.kind IN ('event','holiday')", 'a.start_date <= ?', 'COALESCE(a.end_date, a.start_date) >= ?']; const p = [last, first];
+  if (req.user.role !== 'admin') {
+    const aud = AUD[req.user.role].filter((x) => x !== 'class'); const cls = myClassIds(req.user);
+    where.push(`(a.audience IN (${aud.map(() => '?').join(',')}) OR (a.audience = 'class' AND a.class_id IN (${cls.map(() => '?').join(',') || 'NULL'})))`); p.push(...aud, ...cls);
+  }
+  res.json({ month, rows: all(`${ANN} WHERE ${where.join(' AND ')} ORDER BY a.start_date`, ...p) });
+}));
+
+r.post('/announcements', requireRole('admin', 'teacher'), ah((req, res) => {
+  const b = req.body;
+  const kind = oneOf(b.kind || 'notice', ['notice', 'event', 'holiday', 'circular'], 'kind');
+  let audience = oneOf(b.audience || 'all', ['all', 'parents', 'students', 'staff', 'drivers', 'class'], 'audience');
+  let classId = int(b.class_id || null, 'class', { required: false });
+  if (req.user.role === 'teacher') {          // class teachers post to their own class only
+    audience = 'class'; if (!classId) throw bad('Choose a class');
+    if (ownClassOrAdmin(req.user, classId) === 'teacher') throw forbidden('Only the class teacher can post to the class');
+  }
+  if (audience === 'class' && !classId) throw bad('Choose a class');
+  const start = date(b.start_date || today(), 'start date'), end = date(b.end_date || null, 'end date', { required: false });
+  if (end && end < start) throw bad('End date must be after start date');
+  const title = str(b.title, 'Title', { max: 120 });
+  const id = run(`INSERT INTO announcements(kind, title, body, start_date, end_date, audience, class_id, pinned, created_by) VALUES (?,?,?,?,?,?,?,?,?)`,
+    kind, title, str(b.body, 'Details', { required: false, max: 2000 }), start, end, audience, audience === 'class' ? classId : null, flag(b.pinned), req.user.id).lastInsertRowid;
+  // fan-out notifications
+  let ids = [];
+  if (audience === 'all') ids = all("SELECT id FROM users WHERE status = 'active' AND id <> ?", req.user.id).map((x) => x.id);
+  else if (audience === 'class') {
+    const kids = all("SELECT id, user_id FROM students WHERE class_id = ? AND status = 'active'", classId);
+    ids = [...kids.flatMap((k) => parentIdsOf(k.id)), ...kids.map((k) => k.user_id)];
+  } else {
+    const roles = { parents: ['parent'], students: ['student'], staff: ['teacher', 'finance', 'admin', 'driver'], drivers: ['driver'] }[audience];
+    ids = all(`SELECT id FROM users WHERE status = 'active' AND role IN (${roles.map(() => '?').join(',')})`, ...roles).map((x) => x.id);
+  }
+  notify(ids, { title: `${{ notice: 'Notice', event: 'Event', holiday: 'Holiday', circular: 'Circular' }[kind]}: ${title}`, body: b.body ? String(b.body).slice(0, 200) : null, kind: 'announcement', link: '/notices' });
+  audit(req, 'post_announcement', 'announcement', id, { kind, audience }); res.status(201).json({ id, notified: new Set(ids.filter(Boolean)).size });
+}));
+
+r.delete('/announcements/:id', requireRole('admin', 'teacher'), ah((req, res) => {
+  const a = get('SELECT * FROM announcements WHERE id = ?', req.params.id); if (!a) throw notFound();
+  if (req.user.role !== 'admin' && a.created_by !== req.user.id) throw forbidden();
+  run('DELETE FROM announcements WHERE id = ?', a.id); audit(req, 'delete_announcement', 'announcement', a.id); res.json({ ok: true });
+}));
+
+// ================================================================== BROADCAST (Admin/CT -> families, transport alerts)
+r.post('/broadcast', requireRole('admin', 'teacher'), ah((req, res) => {
+  const title = str(req.body.title, 'Title', { max: 120 }), body = str(req.body.body, 'Message', { required: false, max: 500 });
+  const target = oneOf(req.body.target, ['class', 'route', 'all_parents', 'staff'], 'target');
+  let ids = [];
+  if (target === 'class') {
+    const cid = int(req.body.class_id, 'class'); if (ownClassOrAdmin(req.user, cid) === 'teacher') throw forbidden();
+    const kids = all("SELECT id, user_id FROM students WHERE class_id = ? AND status = 'active'", cid);
+    ids = [...kids.flatMap((k) => parentIdsOf(k.id)), ...kids.map((k) => k.user_id)];
+  } else if (req.user.role !== 'admin') throw forbidden('Only the admin can send this kind of broadcast');
+  else if (target === 'route') {
+    const rid = int(req.body.route_id, 'route');
+    ids = all('SELECT student_id FROM student_transport WHERE route_id = ?', rid).flatMap((x) => parentIdsOf(x.student_id));
+  } else if (target === 'all_parents') ids = all("SELECT id FROM users WHERE role = 'parent' AND status = 'active'").map((x) => x.id);
+  else ids = all("SELECT id FROM users WHERE role IN ('teacher','finance','driver') AND status = 'active'").map((x) => x.id);
+  const n = notify(ids, { title, body, kind: target === 'route' ? 'transport' : 'announcement', sms: flag(req.body.sms) === 1 });
+  audit(req, 'broadcast', null, null, { target, recipients: n }); res.json({ sent: n });
+}));
+
+// ================================================================== DIARY
+const DIARY = `SELECT d.*, s.name AS subject, u.name AS author, c.name || '-' || c.section AS class_label FROM diary d
+  LEFT JOIN subjects s ON s.id = d.subject_id LEFT JOIN users u ON u.id = d.created_by JOIN classes c ON c.id = d.class_id`;
+r.get('/diary', ah((req, res) => {
+  const where = []; const p = [];
+  if (req.user.role === 'admin') { if (req.query.class_id) { where.push('d.class_id = ?'); p.push(Number(req.query.class_id)); } }
+  else if (['teacher', 'parent', 'student'].includes(req.user.role)) {
+    const cls = myClassIds(req.user); where.push(`d.class_id IN (${cls.map(() => '?').join(',') || 'NULL'})`); p.push(...cls);
+    if (req.query.class_id) { where.push('d.class_id = ?'); p.push(Number(req.query.class_id)); }
+  } else throw forbidden();
+  if (req.query.from) { where.push('d.date >= ?'); p.push(req.query.from); }
+  if (req.query.to) { where.push('d.date <= ?'); p.push(req.query.to); }
+  res.json({ rows: all(`${DIARY} ${where.length ? 'WHERE ' + where.join(' AND ') : ''} ORDER BY d.date DESC, d.id DESC LIMIT 200`, ...p) });
+}));
+r.post('/diary', requireRole('admin', 'teacher'), ah((req, res) => {
+  const cid = int(req.body.class_id, 'class'); ownClassOrAdmin(req.user, cid);
+  const id = run('INSERT INTO diary(class_id, subject_id, date, title, body, homework_due, created_by) VALUES (?,?,?,?,?,?,?)', cid, int(req.body.subject_id || null, 'subject', { required: false }),
+    date(req.body.date || today(), 'date'), str(req.body.title, 'Title', { max: 120 }), str(req.body.body, 'Details', { required: false, max: 2000 }), date(req.body.homework_due || null, 'homework due', { required: false }), req.user.id).lastInsertRowid;
+  const kids = all("SELECT id, user_id FROM students WHERE class_id = ? AND status = 'active'", cid);
+  notify([...kids.flatMap((k) => parentIdsOf(k.id)), ...kids.map((k) => k.user_id)], { title: `Diary: ${req.body.title}`, body: req.body.homework_due ? `Homework due ${req.body.homework_due}` : null, kind: 'diary', link: '/diary' });
+  audit(req, 'diary_entry', 'diary', id); res.status(201).json({ id });
+}));
+r.delete('/diary/:id', requireRole('admin', 'teacher'), ah((req, res) => {
+  const d = get('SELECT * FROM diary WHERE id = ?', req.params.id); if (!d) throw notFound();
+  if (req.user.role !== 'admin' && d.created_by !== req.user.id) throw forbidden();
+  run('DELETE FROM diary WHERE id = ?', d.id); res.json({ ok: true });
+}));
+
+// ================================================================== SUPPORT TICKETS (Parent -> Class Teacher, with status)
+const TK = `SELECT t.*, s.name AS student_name, s.admission_no, ru.name AS raised_by_name, au.name AS assigned_to_name,
+  (SELECT COUNT(*) FROM ticket_messages m WHERE m.ticket_id = t.id) AS messages FROM tickets t JOIN students s ON s.id = t.student_id
+  LEFT JOIN users ru ON ru.id = t.raised_by LEFT JOIN users au ON au.id = t.assigned_to`;
+function ticketAccess(user, t) {
+  if (user.role === 'admin') return true;
+  if (user.role === 'teacher') return t.assigned_to === user.id || teacherClasses(user.id).ct.includes(get('SELECT class_id FROM students WHERE id = ?', t.student_id)?.class_id);
+  if (user.role === 'parent' || user.role === 'student') return childIds(user).includes(t.student_id);
+  return false;
+}
+r.get('/tickets', ah((req, res) => {
+  const where = []; const p = [];
+  if (req.user.role === 'parent' || req.user.role === 'student') { const kids = childIds(req.user); where.push(`t.student_id IN (${kids.map(() => '?').join(',') || 'NULL'})`); p.push(...kids); }
+  else if (req.user.role === 'teacher') { const ct = teacherClasses(req.user.id).ct; where.push(`(t.assigned_to = ? OR t.student_id IN (SELECT id FROM students WHERE class_id IN (${ct.map(() => '?').join(',') || 'NULL'})))`); p.push(req.user.id, ...ct); }
+  else if (req.user.role !== 'admin') throw forbidden();
+  if (req.query.status) { where.push('t.status = ?'); p.push(req.query.status); }
+  res.json({ rows: all(`${TK} ${where.length ? 'WHERE ' + where.join(' AND ') : ''} ORDER BY CASE t.status WHEN 'open' THEN 0 WHEN 'in_progress' THEN 1 WHEN 'resolved' THEN 2 ELSE 3 END, t.updated_at DESC LIMIT 200`, ...p) });
+}));
+r.post('/tickets', ah((req, res) => {
+  const sid = int(req.body.student_id, 'student'); const { student, level } = studentAccess(req.user, sid);
+  if (level !== 'family') throw forbidden('Parents and students raise support tickets');
+  const ct = student.class_id ? classTeacherOf(student.class_id) : null;
+  const id = tx(() => {
+    const tid = run('INSERT INTO tickets(ticket_no, student_id, raised_by, assigned_to, subject, category, priority) VALUES (?,?,?,?,?,?,?)',
+      nextSeq('ticket', 'TKT', 4), sid, req.user.id, ct, str(req.body.subject, 'Subject', { max: 120 }), str(req.body.category, 'category', { required: false, max: 30 }) || 'general',
+      oneOf(req.body.priority || 'normal', ['low', 'normal', 'high'], 'priority')).lastInsertRowid;
+    run('INSERT INTO ticket_messages(ticket_id, user_id, body) VALUES (?,?,?)', tid, req.user.id, str(req.body.message, 'Message', { max: 2000 }));
+    return tid;
+  });
+  const msg = { title: 'New support ticket', body: `${student.name}: ${req.body.subject}`, kind: 'ticket', link: `/tickets/${id}` };
+  if (ct) notify(ct, msg); else notifyAdmins(msg);
+  audit(req, 'create_ticket', 'ticket', id); res.status(201).json({ id });
+}));
+r.get('/tickets/:id', ah((req, res) => {
+  const t = get(`${TK} WHERE t.id = ?`, req.params.id); if (!t) throw notFound();
+  if (!ticketAccess(req.user, t)) throw forbidden();
+  res.json({ ticket: t, messages: all('SELECT m.*, u.name AS author, u.role FROM ticket_messages m JOIN users u ON u.id = m.user_id WHERE m.ticket_id = ? ORDER BY m.id', t.id) });
+}));
+r.post('/tickets/:id/messages', ah((req, res) => {
+  const t = get('SELECT * FROM tickets WHERE id = ?', req.params.id); if (!t) throw notFound();
