+++ b/server/src/routes/hr.js
@@ -0,0 +1,177 @@
+import { Router } from 'express';
+import { get, all, run, tx, nextSeq } from '../db/index.js';
+import { ah, bad, notFound, forbidden, conflict, str, int, num, date, oneOf, today, addDays, money, mobile as vMobile } from '../utils/http.js';
+import { authenticate, requireRole } from '../middleware/auth.js';
+import { audit } from '../utils/audit.js';
+import { notify, notifyAdmins } from '../utils/notify.js';
+import { employeeOfUser } from '../utils/hr.js';
+import { sendRows } from '../utils/csv.js';
+
+const r = Router();
+r.use(authenticate);
+const hrStaff = requireRole('admin', 'finance');
+
+// ============================================================ employees (teaching, non-teaching, drivers, co-drivers)
+r.get('/employees', hrStaff, ah((req, res) => {
+  const where = []; const p = [];
+  if (req.query.type) { where.push('e.type = ?'); p.push(req.query.type); }
+  if (req.query.status) { where.push('e.status = ?'); p.push(req.query.status); }
+  if (req.query.q) { where.push('(e.name LIKE ? OR e.emp_code LIKE ? OR e.mobile LIKE ?)'); const l = `%${req.query.q}%`; p.push(l, l, l); }
+  const rows = all(`SELECT e.*, u.email, u.status AS login_status FROM employees e LEFT JOIN users u ON u.id = e.user_id
+    ${where.length ? 'WHERE ' + where.join(' AND ') : ''} ORDER BY e.status, e.type, e.name`, ...p);
+  if (req.user.role === 'finance') { /* finance sees pay data */ }
+  return sendRows(req, res, rows, 'employees');
+}));
+function empBody(b, ex = {}) {
+  const m = { ...ex, ...b };
+  return [str(m.name, 'Name', { max: 100 }), vMobile(m.mobile || null, 'mobile', { required: false }), oneOf(m.type, ['teacher', 'admin_staff', 'finance', 'driver', 'co_driver', 'other'], 'type'),
+    str(m.designation, 'Designation', { required: false, max: 60 }), str(m.department, 'Department', { required: false, max: 60 }), date(m.join_date || null, 'join date', { required: false }),
+    str(m.address, 'Address', { required: false, max: 300 }), str(m.id_proof, 'ID proof', { required: false, max: 60 }), str(m.emergency_contact, 'Emergency contact', { required: false, max: 60 }),
+    str(m.bank_account, 'Bank account', { required: false, max: 40 }), num(m.basic_salary ?? 0, 'Basic salary', { min: 0 }), num(m.allowances ?? 0, 'Allowances', { min: 0 }), num(m.deductions ?? 0, 'Deductions', { min: 0 }),
+    str(m.license_no, 'License no', { required: false, max: 30 }), date(m.license_expiry || null, 'license expiry', { required: false })];
+}
+r.post('/employees', requireRole('admin'), ah((req, res) => {
+  const v = empBody(req.body);
+  const id = tx(() => run(`INSERT INTO employees(emp_code, name, mobile, type, designation, department, join_date, address, id_proof, emergency_contact, bank_account, basic_salary, allowances, deductions, license_no, license_expiry)
+    VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`, nextSeq('employee', 'EMP', 4), ...v).lastInsertRowid);
+  audit(req, 'create_employee', 'employee', id); res.status(201).json({ id });
+}));
+r.put('/employees/:id', requireRole('admin'), ah((req, res) => {
+  const ex = get('SELECT * FROM employees WHERE id = ?', req.params.id); if (!ex) throw notFound();
+  const v = empBody(req.body, ex);
+  run(`UPDATE employees SET name=?, mobile=?, type=?, designation=?, department=?, join_date=?, address=?, id_proof=?, emergency_contact=?, bank_account=?, basic_salary=?, allowances=?, deductions=?, license_no=?, license_expiry=?, status=? WHERE id=?`,
+    ...v, oneOf(req.body.status ?? ex.status, ['active', 'inactive'], 'status'), ex.id);
+  audit(req, 'update_employee', 'employee', ex.id); res.json({ ok: true });
+}));
+
+// ============================================================ staff attendance
+r.get('/attendance', requireRole('admin'), ah((req, res) => {
+  const d = date(req.query.date || today(), 'date');
+  res.json({ date: d, rows: all(`SELECT e.id AS employee_id, e.emp_code, e.name, e.type, a.status,
+     EXISTS(SELECT 1 FROM staff_leaves l WHERE l.employee_id = e.id AND l.status = 'approved' AND ? BETWEEN l.from_date AND l.to_date) AS on_approved_leave
+     FROM employees e LEFT JOIN staff_attendance a ON a.employee_id = e.id AND a.date = ? WHERE e.status = 'active' ORDER BY e.type, e.name`, d, d) });
+}));
+r.post('/attendance', requireRole('admin'), ah((req, res) => {
+  const d = date(req.body.date, 'date'); if (d > today()) throw bad('Cannot mark a future date');
+  const recs = Array.isArray(req.body.records) ? req.body.records : [];
+  tx(() => { for (const x of recs) run(`INSERT INTO staff_attendance(employee_id, date, status, marked_by) VALUES (?,?,?,?)
+    ON CONFLICT(employee_id, date) DO UPDATE SET status = excluded.status, marked_by = excluded.marked_by`, int(x.employee_id, 'employee'), d, oneOf(x.status, ['P', 'A', 'L', 'H'], 'status'), req.user.id); });
+  audit(req, 'staff_attendance', 'employee', null, { date: d, count: recs.length }); res.json({ ok: true, saved: recs.length });
+}));
+
+// ============================================================ staff leaves
+const SL = `SELECT l.*, e.name AS employee_name, e.emp_code, e.type, du.name AS decided_by_name FROM staff_leaves l JOIN employees e ON e.id = l.employee_id LEFT JOIN users du ON du.id = l.decided_by`;
+r.get('/leaves', ah((req, res) => {
+  if (req.user.role === 'admin') return res.json({ rows: all(`${SL} ${req.query.status ? 'WHERE l.status = ?' : ''} ORDER BY CASE l.status WHEN 'pending' THEN 0 ELSE 1 END, l.id DESC LIMIT 300`, ...(req.query.status ? [req.query.status] : [])) });
+  const emp = employeeOfUser(req.user.id);
+  res.json({ rows: emp ? all(`${SL} WHERE l.employee_id = ? ORDER BY l.id DESC`, emp.id) : [] });
+}));
+r.post('/leaves', requireRole('admin', 'teacher', 'finance', 'driver'), ah((req, res) => {
+  const emp = req.user.role === 'admin' && req.body.employee_id ? get('SELECT * FROM employees WHERE id = ?', req.body.employee_id) : employeeOfUser(req.user.id);
+  if (!emp) throw bad('No HR record is linked to your account');
+  const from = date(req.body.from_date, 'From'), to = date(req.body.to_date, 'To'); if (to < from) throw bad('To date must be after From date');
+  if (get(`SELECT 1 x FROM staff_leaves WHERE employee_id = ? AND status IN ('pending','approved') AND from_date <= ? AND to_date >= ?`, emp.id, to, from)) throw conflict('You already have leave covering these dates');
+  const id = run('INSERT INTO staff_leaves(employee_id, leave_type, from_date, to_date, reason) VALUES (?,?,?,?,?)', emp.id, oneOf(req.body.leave_type || 'casual', ['casual', 'sick', 'earned', 'unpaid'], 'leave type'), from, to, str(req.body.reason, 'Reason', { required: false, max: 300 })).lastInsertRowid;
+  notifyAdmins({ title: 'Staff leave request', body: `${emp.name}: ${from} to ${to}`, kind: 'leave', link: '/hr/leaves' });
+  res.status(201).json({ id });
+}));
+r.post('/leaves/:id/decide', requireRole('admin'), ah((req, res) => {
+  const l = get('SELECT l.*, e.user_id FROM staff_leaves l JOIN employees e ON e.id = l.employee_id WHERE l.id = ?', req.params.id); if (!l) throw notFound();
+  if (l.status !== 'pending') throw conflict(`Already ${l.status}`);
+  const decision = oneOf(req.body.decision, ['approved', 'rejected'], 'decision');
+  tx(() => {
+    run("UPDATE staff_leaves SET status = ?, decided_by = ?, decision_note = ? WHERE id = ?", decision, req.user.id, str(req.body.note, 'note', { required: false, max: 200 }), l.id);
+    if (decision === 'approved') for (let d = l.from_date; d <= l.to_date; d = addDays(d, 1)) {
+      if (new Date(`${d}T00:00:00Z`).getUTCDay() === 0) continue;
+      run("INSERT OR IGNORE INTO staff_attendance(employee_id, date, status, marked_by) VALUES (?,?,'L',?)", l.employee_id, d, req.user.id);
+    }
+  });
+  if (l.user_id) notify(l.user_id, { title: `Leave ${decision}`, body: `${l.from_date} to ${l.to_date}`, kind: 'leave', link: '/hr/leaves', sms: true });
+  audit(req, `staff_leave_${decision}`, 'staff_leave', l.id); res.json({ ok: true });
+}));
+r.post('/leaves/:id/cancel', ah((req, res) => {
+  const l = get('SELECT l.*, e.user_id FROM staff_leaves l JOIN employees e ON e.id = l.employee_id WHERE l.id = ?', req.params.id); if (!l) throw notFound();
+  if (l.user_id !== req.user.id && req.user.role !== 'admin') throw forbidden();
+  if (l.status !== 'pending') throw conflict('Only pending requests can be cancelled');
+  run("UPDATE staff_leaves SET status = 'cancelled' WHERE id = ?", l.id); res.json({ ok: true });
+}));
+
+// ============================================================ payroll
+export function workingDays(month) {
+  const [y, m] = month.split('-').map(Number); const n = new Date(Date.UTC(y, m, 0)).getUTCDate(); let c = 0;
+  for (let d = 1; d <= n; d++) if (new Date(Date.UTC(y, m - 1, d)).getUTCDay() !== 0) c++;
+  return c;
+}
+/** Create (or top-up) a draft payroll run for a month. Safe to call twice. */
+export function generatePayroll(month, userId = null) {
+  return tx(() => {
+    let run_ = get('SELECT * FROM payroll_runs WHERE month = ?', month);
+    if (run_ && run_.status !== 'draft') throw conflict(`Payroll for ${month} is already ${run_.status}`);
+    if (!run_) run_ = { id: run('INSERT INTO payroll_runs(month, created_by) VALUES (?,?)', month, userId).lastInsertRowid };
+    const wd = workingDays(month); let n = 0;
+    const from = `${month}-01`, to = `${month}-31`;
+    for (const e of all("SELECT * FROM employees WHERE status = 'active'")) {
+      if (get('SELECT 1 x FROM payslips WHERE run_id = ? AND employee_id = ?', run_.id, e.id)) continue;
+      if (e.join_date && e.join_date.slice(0, 7) > month) continue;
+      const a = get(`SELECT COUNT(*) n, COALESCE(SUM(status='P'),0) p, COALESCE(SUM(status='H'),0) h, COALESCE(SUM(status='A'),0) a FROM staff_attendance WHERE employee_id = ? AND date BETWEEN ? AND ?`, e.id, from, to);
+      const unpaidLeave = get(`SELECT COALESCE(SUM(julianday(MIN(to_date, ?)) - julianday(MAX(from_date, ?)) + 1), 0) d FROM staff_leaves
+         WHERE employee_id = ? AND status = 'approved' AND leave_type = 'unpaid' AND from_date <= ? AND to_date >= ?`, to, from, e.id, to, from).d;
+      // No attendance recorded at all => assume full attendance; otherwise absences (and half days) are deducted
+      const absentDays = a.n ? a.a + a.h * 0.5 : 0;
+      const lossDays = Math.min(wd, absentDays + unpaidLeave);
+      const perDay = e.basic_salary / wd;
+      const leaveDed = money(perDay * lossDays);
+      const net = money(e.basic_salary + e.allowances - e.deductions - leaveDed);
+      run(`INSERT INTO payslips(run_id, employee_id, working_days, present_days, basic, allowances, deductions, leave_deduction, net) VALUES (?,?,?,?,?,?,?,?,?)`,
+        run_.id, e.id, wd, money(wd - lossDays), e.basic_salary, e.allowances, e.deductions, leaveDed, Math.max(0, net)); n++;
+    }
+    return { id: run_.id, created: n };
+  });
+}
+const SLIP = `SELECT p.*, e.name, e.emp_code, e.type, e.designation, e.bank_account, r.month, r.status AS run_status FROM payslips p JOIN employees e ON e.id = p.employee_id JOIN payroll_runs r ON r.id = p.run_id`;
+
+r.get('/payroll/runs', hrStaff, ah((_req, res) => res.json({ rows: all(`SELECT r.*, (SELECT COUNT(*) FROM payslips p WHERE p.run_id = r.id) AS slips, (SELECT COALESCE(SUM(net),0) FROM payslips p WHERE p.run_id = r.id) AS total_net FROM payroll_runs r ORDER BY r.month DESC`) })));
+r.post('/payroll/runs', hrStaff, ah((req, res) => {
+  const month = str(req.body.month, 'Month', { max: 7 }); if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) throw bad('Month must be YYYY-MM');
+  const out = generatePayroll(month, req.user.id); audit(req, 'generate_payroll', 'payroll_run', out.id, { month }); res.status(201).json(out);
+}));
+r.get('/payroll/runs/:id', hrStaff, ah((req, res) => {
+  const run_ = get('SELECT * FROM payroll_runs WHERE id = ?', req.params.id); if (!run_) throw notFound();
+  res.json({ run: run_, rows: all(`${SLIP} WHERE p.run_id = ? ORDER BY e.type, e.name`, run_.id) });
+}));
+r.put('/payroll/payslips/:id', hrStaff, ah((req, res) => {
+  const p = get('SELECT p.*, r.status AS rs FROM payslips p JOIN payroll_runs r ON r.id = p.run_id WHERE p.id = ?', req.params.id); if (!p) throw notFound();
+  if (p.rs !== 'draft') throw conflict('Only draft payslips can be edited');
+  const bonus = num(req.body.bonus ?? p.bonus, 'Bonus', { min: 0 }), ded = num(req.body.deductions ?? p.deductions, 'Deductions', { min: 0 });
+  const net = Math.max(0, money(p.basic + p.allowances + bonus - ded - p.leave_deduction));
+  run('UPDATE payslips SET bonus = ?, deductions = ?, net = ? WHERE id = ?', bonus, ded, net, p.id); res.json({ ok: true, net });
+}));
+r.post('/payroll/runs/:id/finalize', hrStaff, ah((req, res) => {
+  const run_ = get('SELECT * FROM payroll_runs WHERE id = ?', req.params.id); if (!run_) throw notFound();
+  if (run_.status !== 'draft') throw conflict(`Run is already ${run_.status}`);
+  tx(() => { run("UPDATE payroll_runs SET status = 'finalized' WHERE id = ?", run_.id); run("UPDATE payslips SET status = 'finalized' WHERE run_id = ?", run_.id); });
+  audit(req, 'finalize_payroll', 'payroll_run', run_.id); res.json({ ok: true });
+}));
+r.post('/payroll/runs/:id/pay', requireRole('admin', 'finance'), ah((req, res) => {
+  const run_ = get('SELECT * FROM payroll_runs WHERE id = ?', req.params.id); if (!run_) throw notFound();
+  if (run_.status !== 'finalized') throw conflict('Finalize the run before marking it paid');
+  const total = tx(() => {
+    run("UPDATE payroll_runs SET status = 'paid' WHERE id = ?", run_.id);
+    run("UPDATE payslips SET status = 'paid', paid_on = date('now') WHERE run_id = ?", run_.id);
+    const t = get('SELECT COALESCE(SUM(net),0) t FROM payslips WHERE run_id = ?', run_.id).t;
+    run("INSERT INTO expenses(expense_date, category, vendor, description, amount, payment_status, added_by) VALUES (date('now'),'Payroll','Staff',?,?,'paid',?)", `Salaries for ${run_.month}`, Math.max(0.01, t), req.user.id);   // books itself into finance
+    return t;
+  });
+  for (const x of all('SELECT e.user_id FROM payslips p JOIN employees e ON e.id = p.employee_id WHERE p.run_id = ? AND e.user_id IS NOT NULL', run_.id))
+    notify(x.user_id, { title: 'Salary paid', body: `Your salary for ${run_.month} has been paid.`, kind: 'payroll', link: '/my/payslips', sms: true });
+  audit(req, 'pay_payroll', 'payroll_run', run_.id, { total }); res.json({ ok: true, total: money(total) });
+}));
+
+// my payslips (any employee login: teacher, driver, finance)
+r.get('/my/payslips', ah((req, res) => {
+  const emp = employeeOfUser(req.user.id);
+  res.json({ employee: emp, rows: emp ? all(`${SLIP} WHERE p.employee_id = ? AND r.status IN ('finalized','paid') ORDER BY r.month DESC`, emp.id) : [] });
+}));
+r.get('/my/profile', ah((req, res) => res.json({ employee: employeeOfUser(req.user.id) })));
+
+export default r;
diff --git a/server/src/routes/reports.js b/server/src/routes/reports.js
new file mode 100644
index 0000000..bb0c42e
--- /dev/null
+++ b/server/src/routes/reports.js
@@ -0,0 +1,50 @@
+import { Router } from 'express';
+import { all, get } from '../db/index.js';
+import { ah, bad, date, today, addDays, oneOf, money } from '../utils/http.js';
+import { authenticate, requireRole } from '../middleware/auth.js';
+import { sendRows } from '../utils/csv.js';
+
+const r = Router();
+r.use(authenticate, requireRole('admin', 'finance'));
+
+r.get('/fee-collection', ah((req, res) => {
+  const to = date(req.query.to || today(), 'to'), from = date(req.query.from || addDays(to, -30), 'from');
+  const group = oneOf(req.query.group || 'day', ['day', 'month', 'method', 'class', 'fee_head'], 'group');
+  const expr = {
+    day: 'date(p.paid_at)', month: 'substr(p.paid_at,1,7)', method: 'p.method',
+    class: "COALESCE(c.name || '-' || c.section, 'Unassigned')", fee_head: 'COALESCE(f.name, i.description)',
+  }[group];
+  const rows = all(`SELECT ${expr} AS label, COUNT(*) AS payments, ROUND(SUM(p.amount),2) AS total
+    FROM payments p JOIN invoices i ON i.id = p.invoice_id JOIN students s ON s.id = p.student_id
+    LEFT JOIN classes c ON c.id = s.class_id LEFT JOIN fee_structures f ON f.id = i.structure_id
+    WHERE p.status = 'success' AND date(p.paid_at) BETWEEN ? AND ? GROUP BY 1 ORDER BY ${group === 'day' || group === 'month' ? '1' : '3 DESC'}`, from, to);
+  if (req.query.format === 'csv') return sendRows(req, res, rows, `fee-collection-${group}`);
+  res.json({ from, to, group, rows, total: money(rows.reduce((a, b) => a + b.total, 0)) });
+}));
+
+r.get('/outstanding', ah((req, res) => {
+  const where = ["b.status IN ('unpaid','partial')"]; const p = [];
+  if (req.query.class_id) { where.push('s.class_id = ?'); p.push(Number(req.query.class_id)); }
+  if (req.query.overdue === '1') where.push("b.due_date < date('now')");
+  const rows = all(`SELECT s.id AS student_id, s.name AS student, s.admission_no, s.mobile, c.name || '-' || c.section AS class,
+      COUNT(*) AS invoices, ROUND(SUM(b.total),2) AS billed, ROUND(SUM(b.paid),2) AS paid, ROUND(SUM(b.balance),2) AS balance,
+      MIN(b.due_date) AS oldest_due, CAST(julianday('now') - julianday(MIN(b.due_date)) AS INTEGER) AS days_overdue
+    FROM v_invoice_balance b JOIN students s ON s.id = b.student_id LEFT JOIN classes c ON c.id = s.class_id
+    WHERE ${where.join(' AND ')} GROUP BY s.id ORDER BY balance DESC`, ...p);
+  rows.forEach((x) => { if (x.days_overdue < 0) x.days_overdue = 0; });
+  return sendRows(req, res, rows, 'outstanding-fees');
+}));
+
+r.get('/expenses', ah((req, res) => {
+  const to = date(req.query.to || today(), 'to'), from = date(req.query.from || addDays(to, -90), 'from');
+  const rows = all(`SELECT category, COUNT(*) AS entries, ROUND(SUM(amount),2) AS total FROM expenses WHERE expense_date BETWEEN ? AND ? GROUP BY category ORDER BY total DESC`, from, to);
+  return sendRows(req, res, rows, 'expense-summary');
+}));
+
+r.get('/strength', ah((_req, res) => {
+  res.json({ rows: all(`SELECT c.name || '-' || c.section AS class, c.capacity, COUNT(s.id) AS students,
+     SUM(s.gender = 'male') AS boys, SUM(s.gender = 'female') AS girls
+     FROM classes c LEFT JOIN students s ON s.class_id = c.id AND s.status = 'active' GROUP BY c.id ORDER BY c.name, c.section`) });
+}));
+
+export default r;
diff --git a/server/src/routes/requests.js b/server/src/routes/requests.js
new file mode 100644
index 0000000..0cf1f19
--- /dev/null
+++ b/server/src/routes/requests.js
@@ -0,0 +1,128 @@
+import { Router } from 'express';
+import { get, all, run, tx } from '../db/index.js';
+import { ah, bad, notFound, forbidden, conflict, str, int, date, oneOf, mobile as vMobile, today, addDays } from '../utils/http.js';
+import { authenticate, requireRole } from '../middleware/auth.js';
+import { audit } from '../utils/audit.js';
+import { notify, notifyAdmins, notifyFamily, classTeacherOf } from '../utils/notify.js';
+import { studentAccess, canManage, teacherClasses, childIds } from '../utils/access.js';
+
+const r = Router();
+r.use(authenticate);
+
+// ======================================================================= STUDENT LEAVE  (Parent -> Class Teacher)
+const LEAVE = `SELECT l.*, s.name AS student_name, s.admission_no, c.name || '-' || c.section AS class_label,
+   ru.name AS requested_by_name, ct.name AS routed_to_name, du.name AS decided_by_name
+   FROM leaves l JOIN students s ON s.id = l.student_id LEFT JOIN classes c ON c.id = s.class_id
+   LEFT JOIN users ru ON ru.id = l.requested_by LEFT JOIN users ct ON ct.id = l.routed_to LEFT JOIN users du ON du.id = l.decided_by`;
+
+r.get('/leaves', ah((req, res) => {
+  const where = []; const p = [];
+  const { role, id } = req.user;
+  if (role === 'parent' || role === 'student') {
+    const kids = childIds(req.user); where.push(`l.student_id IN (${kids.map(() => '?').join(',') || 'NULL'})`); p.push(...kids);
+  } else if (role === 'teacher') {
+    const ct = teacherClasses(id).ct; where.push(`(l.routed_to = ? OR s.class_id IN (${ct.map(() => '?').join(',') || 'NULL'}))`); p.push(id, ...ct);
+  } else if (role !== 'admin') throw forbidden();
+  if (req.query.status) { where.push('l.status = ?'); p.push(req.query.status); }
+  if (req.query.student_id) { where.push('l.student_id = ?'); p.push(Number(req.query.student_id)); }
+  res.json({ rows: all(`${LEAVE} ${where.length ? 'WHERE ' + where.join(' AND ') : ''} ORDER BY CASE l.status WHEN 'pending' THEN 0 ELSE 1 END, l.id DESC LIMIT 300`, ...p) });
+}));
+
+r.post('/leaves', ah((req, res) => {
+  const sid = int(req.body.student_id, 'student');
+  const { student, level } = studentAccess(req.user, sid);
+  if (!(level === 'family' || canManage(level))) throw forbidden();
+  if (student.status !== 'active') throw bad('This student is inactive');
+  const from = date(req.body.from_date, 'From date'), to = date(req.body.to_date, 'To date');
+  if (to < from) throw bad('To date must be on or after From date');
+  if (from < addDays(today(), -7)) throw bad('Leave cannot start more than 7 days in the past');
+  if (get(`SELECT 1 x FROM leaves WHERE student_id = ? AND status IN ('pending','approved') AND from_date <= ? AND to_date >= ?`, sid, to, from)) throw conflict('A leave request already covers some of these dates');
+  const ct = student.class_id ? classTeacherOf(student.class_id) : null;
+  const reason = str(req.body.reason, 'Reason', { max: 300, min: 3 });
+  const id = run('INSERT INTO leaves(student_id, requested_by, from_date, to_date, reason, routed_to) VALUES (?,?,?,?,?,?)', sid, req.user.id, from, to, reason, ct).lastInsertRowid;
+  if (ct) notify(ct, { title: 'New leave request', body: `${student.name}: ${from} to ${to} - ${reason}`, kind: 'leave', link: '/leaves' });
+  else notifyAdmins({ title: 'Leave request (no class teacher assigned)', body: `${student.name}: ${from} to ${to}`, kind: 'leave', link: '/leaves' });
+  audit(req, 'request_leave', 'leave', id); res.status(201).json({ id, routed_to: ct });
+}));
+
+r.post('/leaves/:id/decide', requireRole('admin', 'teacher'), ah((req, res) => {
+  const l = get('SELECT * FROM leaves WHERE id = ?', req.params.id); if (!l) throw notFound();
+  const { student, level } = studentAccess(req.user, l.student_id);
+  if (!canManage(level)) throw forbidden('Only the class teacher or admin can decide leave requests');
+  if (l.status !== 'pending') throw conflict(`Already ${l.status}`);
+  const decision = oneOf(req.body.decision, ['approved', 'rejected'], 'decision');
+  tx(() => {
+    run("UPDATE leaves SET status = ?, decided_by = ?, decision_note = ?, decided_at = datetime('now') WHERE id = ?", decision, req.user.id, str(req.body.note, 'note', { required: false, max: 200 }), l.id);
+    if (decision === 'approved') { // reflect approved leave in the attendance register (never overwrites a real mark)
+      for (let d = l.from_date; d <= l.to_date; d = addDays(d, 1)) {
+        if (new Date(`${d}T00:00:00Z`).getUTCDay() === 0) continue;
+        run("INSERT OR IGNORE INTO attendance(student_id, class_id, date, status, note, marked_by) VALUES (?,?,?,'L','Approved leave',?)", student.id, student.class_id, d, req.user.id);
+      }
+    }
+  });
+  notifyFamily(student.id, { title: `Leave ${decision}`, body: `${l.from_date} to ${l.to_date}${req.body.note ? ' - ' + req.body.note : ''}`, kind: 'leave', link: '/leaves', sms: true });
+  audit(req, `leave_${decision}`, 'leave', l.id); res.json({ ok: true });
+}));
+
+r.post('/leaves/:id/cancel', ah((req, res) => {
+  const l = get('SELECT * FROM leaves WHERE id = ?', req.params.id); if (!l) throw notFound();
+  if (l.requested_by !== req.user.id && req.user.role !== 'admin') throw forbidden();
+  if (l.status !== 'pending') throw conflict('Only pending requests can be cancelled');
+  run("UPDATE leaves SET status = 'cancelled' WHERE id = ?", l.id); res.json({ ok: true });
+}));
+
+// ======================================================================= CHANGE / MODIFICATION REQUESTS  (Parent -> CT / Admin)
+const ADMIN_ONLY_FIELDS = new Set(['name', 'dob']);
+const CR = `SELECT cr.*, s.name AS student_name, s.admission_no, c.name || '-' || c.section AS class_label, ru.name AS requested_by_name, du.name AS decided_by_name
+  FROM change_requests cr JOIN students s ON s.id = cr.student_id LEFT JOIN classes c ON c.id = s.class_id
+  LEFT JOIN users ru ON ru.id = cr.requested_by LEFT JOIN users du ON du.id = cr.decided_by`;
+
+r.get('/change-requests', ah((req, res) => {
+  const where = []; const p = [];
+  const { role, id } = req.user;
+  if (role === 'parent' || role === 'student') { const kids = childIds(req.user); where.push(`cr.student_id IN (${kids.map(() => '?').join(',') || 'NULL'})`); p.push(...kids); }
+  else if (role === 'teacher') { const ct = teacherClasses(id).ct; where.push(`(cr.routed_to = ? OR s.class_id IN (${ct.map(() => '?').join(',') || 'NULL'}))`); p.push(id, ...ct); }
+  else if (role !== 'admin') throw forbidden();
+  if (req.query.status) { where.push('cr.status = ?'); p.push(req.query.status); }
+  res.json({ rows: all(`${CR} ${where.length ? 'WHERE ' + where.join(' AND ') : ''} ORDER BY CASE cr.status WHEN 'pending' THEN 0 ELSE 1 END, cr.id DESC LIMIT 300`, ...p) });
+}));
+
+r.post('/change-requests', ah((req, res) => {
+  const sid = int(req.body.student_id, 'student');
+  const { student, level } = studentAccess(req.user, sid);
+  if (level !== 'family') throw forbidden('Parents and students raise change requests');
+  const field = oneOf(req.body.field, ['name', 'mobile', 'dob', 'address', 'guardian_name', 'blood_group'], 'field');
+  let value = str(req.body.new_value, 'New value', { max: 300 });
+  if (field === 'mobile') value = vMobile(value, 'New mobile');
+  if (field === 'dob') value = date(value, 'New date of birth');
+  if (value === String(student[field] ?? '')) throw bad('That is already the current value');
+  if (get("SELECT 1 x FROM change_requests WHERE student_id = ? AND field = ? AND status = 'pending'", sid, field)) throw conflict('A pending request for this field already exists');
+  const approverRole = ADMIN_ONLY_FIELDS.has(field) ? 'admin' : 'teacher';
+  const ct = student.class_id ? classTeacherOf(student.class_id) : null;
+  const routed = approverRole === 'teacher' ? ct : null;
+  const id = run('INSERT INTO change_requests(student_id, requested_by, field, old_value, new_value, reason, approver_role, routed_to) VALUES (?,?,?,?,?,?,?,?)',
+    sid, req.user.id, field, student[field] ?? null, value, str(req.body.reason, 'Reason', { required: false, max: 200 }), approverRole, routed).lastInsertRowid;
+  const msg = { title: 'Student detail change request', body: `${student.name}: change ${field.replace('_', ' ')}`, kind: 'request', link: '/requests' };
+  if (routed) notify(routed, msg); else notifyAdmins(msg);
+  audit(req, 'request_change', 'change_request', id, { field }); res.status(201).json({ id, goes_to: routed ? 'class teacher' : 'admin' });
+}));
+
+r.post('/change-requests/:id/decide', requireRole('admin', 'teacher'), ah((req, res) => {
+  const c = get('SELECT * FROM change_requests WHERE id = ?', req.params.id); if (!c) throw notFound();
+  const { student, level } = studentAccess(req.user, c.student_id);
+  if (!canManage(level)) throw forbidden();
+  if (c.approver_role === 'admin' && req.user.role !== 'admin') throw forbidden('This change needs admin approval');
+  if (c.status !== 'pending') throw conflict(`Already ${c.status}`);
+  const decision = oneOf(req.body.decision, ['approved', 'rejected'], 'decision');
+  tx(() => {
+    if (decision === 'approved') {
+      run(`UPDATE students SET ${c.field} = ? WHERE id = ?`, c.new_value, c.student_id); // field is whitelisted by CHECK + oneOf
+      if (c.field === 'name' && student.user_id) run('UPDATE users SET name = ? WHERE id = ?', c.new_value, student.user_id);
+    }
+    run("UPDATE change_requests SET status = ?, decided_by = ?, decision_note = ?, decided_at = datetime('now') WHERE id = ?", decision, req.user.id, str(req.body.note, 'note', { required: false, max: 200 }), c.id);
+  });
+  notifyFamily(c.student_id, { title: `Change request ${decision}`, body: `${c.field.replace('_', ' ')}: ${c.new_value}`, kind: 'request', link: '/requests' });
+  audit(req, `change_${decision}`, 'change_request', c.id, { field: c.field }); res.json({ ok: true });
+}));
+
+export default r;
diff --git a/server/src/routes/students.js b/server/src/routes/students.js
new file mode 100644
index 0000000..8d26b1f
--- /dev/null
+++ b/server/src/routes/students.js
@@ -0,0 +1,195 @@
+import { Router } from 'express';
+import bcrypt from 'bcryptjs';
+import { get, all, run, tx, nextSeq } from '../db/index.js';
+import { ah, bad, notFound, forbidden, conflict, str, mobile as vMobile, oneOf, int, date, paginate } from '../utils/http.js';
+import { authenticate, requireRole } from '../middleware/auth.js';
+import { audit } from '../utils/audit.js';
+import { notify, notifyAdmins, notifyFamily, classTeacherOf } from '../utils/notify.js';
+import { studentAccess, canManage, visibleStudents } from '../utils/access.js';
+import { tempPassword } from './auth.js';
+import { sendRows } from '../utils/csv.js';
+
+const r = Router();
+r.use(authenticate);
+
+const BASE = `SELECT s.id, s.admission_no, s.name, s.mobile, s.dob, s.gender, s.blood_group, s.address, s.guardian_name,
+  s.class_id, s.roll_no, s.id_card_no, s.status, s.admitted_on, s.deactivation_reason, s.deactivated_role,
+  c.name AS class_name, c.section AS section, c.name || '-' || c.section AS class_label
+  FROM students s LEFT JOIN classes c ON c.id = s.class_id`;
+
+function ftsQuery(q) {
+  const toks = String(q).toLowerCase().match(/[\p{L}\p{N}]+/gu) || [];
+  return toks.length ? toks.map((t) => `"${t}"*`).join(' ') : null;
+}
+
+r.get('/', ah((req, res) => {
+  const { limit, offset } = paginate(req, { max: 500 });
+  const vis = visibleStudents(req.user);
+  const where = [vis.sql]; const p = [...vis.params];
+  if (req.query.class_id) { where.push('s.class_id = ?'); p.push(Number(req.query.class_id)); }
+  if (req.query.status) { where.push('s.status = ?'); p.push(req.query.status); }
+  if (req.query.q) {
+    const m = ftsQuery(req.query.q);
+    if (m) { where.push('s.id IN (SELECT rowid FROM students_fts WHERE students_fts MATCH ?)'); p.push(m); }
+  }
+  const w = `WHERE ${where.join(' AND ')}`;
+  const rows = all(`${BASE} ${w} ORDER BY c.name, c.section, s.roll_no, s.name LIMIT ? OFFSET ?`, ...p, limit, offset);
+  const total = get(`SELECT COUNT(*) n FROM students s ${w}`, ...p).n;
+  if (req.query.format === 'csv') return sendRows(req, res, rows, 'students');
+  res.json({ rows, total });
+}));
+
+// "Mobile + Name" natural key lookup
+r.get('/lookup', requireRole('admin', 'teacher', 'finance'), ah((req, res) => {
+  const mob = vMobile(req.query.mobile);
+  const name = str(req.query.name, 'name', { required: false });
+  const vis = visibleStudents(req.user);
+  const rows = all(`${BASE} WHERE s.mobile = ? ${name ? 'AND s.name = ? COLLATE NOCASE' : ''} AND ${vis.sql}`,
+    ...[mob, ...(name ? [name] : []), ...vis.params]);
+  res.json({ rows });
+}));
+
+function studentPayload(b, existing = {}) {
+  const v = {
+    name: str(b.name ?? existing.name, 'Name', { max: 100 }),
+    mobile: vMobile(b.mobile ?? existing.mobile),
+    dob: date(b.dob ?? existing.dob, 'dob', { required: false }),
+    gender: oneOf(b.gender ?? existing.gender, ['male', 'female', 'other'], 'gender', { required: false }),
+    blood_group: str(b.blood_group ?? existing.blood_group, 'blood group', { required: false, max: 5 }),
+    address: str(b.address ?? existing.address, 'address', { required: false, max: 300 }),
+    guardian_name: str(b.guardian_name ?? existing.guardian_name, 'guardian name', { required: false, max: 100 }),
+    class_id: int(b.class_id ?? existing.class_id, 'class', { required: false }),
+    roll_no: int(b.roll_no ?? existing.roll_no, 'roll no', { required: false, min: 1 }),
+  };
+  if (v.class_id && !get('SELECT id FROM classes WHERE id = ?', v.class_id)) throw bad('Class does not exist');
+  return v;
+}
+
+r.post('/', requireRole('admin'), ah((req, res) => {
+  const v = studentPayload(req.body);
+  const out = tx(() => {
+    const adm = str(req.body.admission_no, 'admission no', { required: false, max: 30 })
+      || nextSeq('admission', `ADM${new Date().getFullYear()}`, 4);
+    const idCard = nextSeq('idcard', `ID${new Date().getFullYear()}`, 4);
+    let userId = null; let studentCred = null;
+    if (req.body.create_login !== false) {
+      const pwd = tempPassword();
+      const info = run("INSERT INTO users(name, email, password_hash, role, status, must_change_password, created_by) VALUES (?,?,?,?, 'active', 1, ?)",
+        v.name, `${adm.toLowerCase()}@students.local`, bcrypt.hashSync(pwd, 10), 'student', req.user.id);
+      userId = info.lastInsertRowid; studentCred = { login: adm, temp_password: pwd };
+    }
+    const info = run(`INSERT INTO students(admission_no, name, mobile, dob, gender, blood_group, address, guardian_name, class_id, roll_no, user_id, id_card_no, admitted_on)
+      VALUES (?,?,?,?,?,?,?,?,?,?,?,?, COALESCE(?, date('now')))`,
+      adm, v.name, v.mobile, v.dob, v.gender, v.blood_group, v.address, v.guardian_name, v.class_id, v.roll_no, userId, idCard,
+      date(req.body.admitted_on, 'admitted_on', { required: false }));
+    const sid = info.lastInsertRowid;
+    let parentCred = null;
+    if (req.body.create_parent) {
+      const ex = get("SELECT id FROM users WHERE mobile = ? AND role = 'parent'", v.mobile);
+      let pid = ex?.id;
+      if (!pid) {
+        const pwd = tempPassword();
+        pid = run("INSERT INTO users(name, mobile, password_hash, role, status, must_change_password, created_by) VALUES (?,?,?, 'parent', 'active', 1, ?)",
+          v.guardian_name || `Parent of ${v.name}`, v.mobile, bcrypt.hashSync(pwd, 10), req.user.id).lastInsertRowid;
+        parentCred = { login: v.mobile, temp_password: pwd };
+      }
+      run('INSERT OR IGNORE INTO parent_students(parent_user_id, student_id, relation) VALUES (?,?,?)', pid, sid, str(req.body.relation, 'relation', { required: false }) || 'guardian');
+    }
+    return { id: sid, admission_no: adm, id_card_no: idCard, student_login: studentCred, parent_login: parentCred };
+  });
+  audit(req, 'create_student', 'student', out.id);
+  res.status(201).json(out);
+}));
+
+r.get('/:id', ah((req, res) => {
+  const { student, level } = studentAccess(req.user, req.params.id);
+  const row = get(`${BASE} WHERE s.id = ?`, student.id);
+  const parents = level === 'family' && req.user.role === 'student' ? [] : all(`SELECT u.id, u.name, u.mobile, u.email, ps.relation FROM parent_students ps
+     JOIN users u ON u.id = ps.parent_user_id WHERE ps.student_id = ?`, student.id);
+  const ct = row.class_id ? get('SELECT u.id, u.name, u.mobile FROM classes c JOIN users u ON u.id = c.class_teacher_id WHERE c.id = ?', row.class_id) : null;
+  const transport = get(`SELECT r.id route_id, r.name route_name, r.via, rs.name stop_name, rs.pickup_time
+     FROM student_transport st JOIN routes r ON r.id = st.route_id LEFT JOIN route_stops rs ON rs.id = st.stop_id WHERE st.student_id = ?`, student.id);
+  res.json({ ...row, level, parents, class_teacher: ct, transport });
+}));
+
+r.put('/:id', ah((req, res) => {
+  const { student, level } = studentAccess(req.user, req.params.id);
+  if (!canManage(level)) throw forbidden();
+  if (level === 'ct') { // class teachers may fix soft details only; identity changes go through the request workflow
+    const b = req.body;
+    run('UPDATE students SET address = ?, guardian_name = ?, blood_group = ?, roll_no = ? WHERE id = ?',
+      str(b.address ?? student.address, 'address', { required: false, max: 300 }),
+      str(b.guardian_name ?? student.guardian_name, 'guardian name', { required: false, max: 100 }),
+      str(b.blood_group ?? student.blood_group, 'blood group', { required: false, max: 5 }),
+      int(b.roll_no ?? student.roll_no, 'roll no', { required: false, min: 1 }), student.id);
+  } else {
+    const v = studentPayload(req.body, student);
+    run(`UPDATE students SET name=?, mobile=?, dob=?, gender=?, blood_group=?, address=?, guardian_name=?, class_id=?, roll_no=? WHERE id=?`,
+      v.name, v.mobile, v.dob, v.gender, v.blood_group, v.address, v.guardian_name, v.class_id, v.roll_no, student.id);
+    if (student.user_id && v.name !== student.name) run('UPDATE users SET name = ? WHERE id = ?', v.name, student.user_id);
+  }
+  audit(req, 'update_student', 'student', student.id);
+  res.json({ ok: true });
+}));
+
+// ---------------------------------------------------- deactivate / reactivate (Admin <-> CT)
+r.post('/:id/deactivate', ah((req, res) => {
+  const { student, level } = studentAccess(req.user, req.params.id);
+  if (!canManage(level)) throw forbidden();
+  if (student.status === 'inactive') throw conflict('Student is already inactive');
+  const reason = str(req.body.reason, 'Reason', { max: 300, min: 3 });
+  tx(() => {
+    run(`UPDATE students SET status='inactive', deactivated_by=?, deactivated_role=?, deactivation_reason=?, deactivated_at=datetime('now') WHERE id=?`,
+      req.user.id, req.user.role === 'admin' ? 'admin' : 'teacher', reason, student.id);
+    if (student.user_id) run("UPDATE users SET status='inactive' WHERE id = ?", student.user_id);
+  });
+  if (level === 'ct') notifyAdmins({ title: 'Student deactivated by class teacher', body: `${student.name} (${student.admission_no}) - ${reason}`, kind: 'student', link: '/students' });
+  else { const ct = student.class_id ? classTeacherOf(student.class_id) : null; if (ct) notify(ct, { title: 'Student deactivated by admin', body: `${student.name} - ${reason}`, kind: 'student' }); }
+  notifyFamily(student.id, { title: 'Student record deactivated', body: reason, kind: 'student' });
+  audit(req, 'deactivate_student', 'student', student.id, { reason });
+  res.json({ ok: true });
+}));
+
+r.post('/:id/activate', ah((req, res) => {
+  const { student, level } = studentAccess(req.user, req.params.id);
+  if (!canManage(level)) throw forbidden();
+  if (student.status === 'active') throw conflict('Student is already active');
+  // Admin decisions win: a class teacher may only undo a deactivation that was made by a class teacher.
+  if (level === 'ct' && student.deactivated_role === 'admin') throw forbidden('This student was deactivated by the admin. Only the admin can reactivate.');
+  tx(() => {
+    run(`UPDATE students SET status='active', deactivated_by=NULL, deactivated_role=NULL, deactivation_reason=NULL, deactivated_at=NULL WHERE id=?`, student.id);
+    if (student.user_id) run("UPDATE users SET status='active' WHERE id = ?", student.user_id);
+  });
+  if (level === 'ct') notifyAdmins({ title: 'Student reactivated by class teacher', body: `${student.name} (${student.admission_no})`, kind: 'student' });
+  notifyFamily(student.id, { title: 'Student record reactivated', kind: 'student' });
+  audit(req, 'activate_student', 'student', student.id);
+  res.json({ ok: true });
+}));
+
+r.post('/:id/reset-login', requireRole('admin'), ah((req, res) => {
+  const s = get('SELECT * FROM students WHERE id = ?', req.params.id);
+  if (!s) throw notFound('Student not found');
+  const pwd = tempPassword();
+  if (s.user_id) {
+    run('UPDATE users SET password_hash=?, must_change_password=1, token_version = token_version + 1 WHERE id=?', bcrypt.hashSync(pwd, 10), s.user_id);
+  } else {
+    const uid = run("INSERT INTO users(name, email, password_hash, role, status, must_change_password, created_by) VALUES (?,?,?,'student','active',1,?)",
+      s.name, `${s.admission_no.toLowerCase()}@students.local`, bcrypt.hashSync(pwd, 10), req.user.id).lastInsertRowid;
+    run('UPDATE students SET user_id = ? WHERE id = ?', uid, s.id);
+  }
+  audit(req, 'reset_student_login', 'student', s.id);
+  res.json({ login: s.admission_no, temp_password: pwd });
+}));
+
+// ------------------------------------------------------------------------- ID card
+r.get('/:id/idcard', ah((req, res) => {
+  const { student } = studentAccess(req.user, req.params.id);
+  const tplId = req.query.template_id;
+  const template = (tplId ? get('SELECT * FROM id_templates WHERE id = ?', tplId) : null)
+    || get('SELECT * FROM id_templates WHERE is_default = 1') || get('SELECT * FROM id_templates LIMIT 1');
+  const full = get(`${BASE} WHERE s.id = ?`, student.id);
+  const school = Object.fromEntries(all("SELECT key, value FROM settings WHERE key IN ('school_name','school_address','school_phone')").map((x) => [x.key, x.value]));
+  res.json({ student: full, template, school, qr: `SMS|${full.id_card_no}|${full.admission_no}|${full.mobile}` });
+}));
+
+export default r;
diff --git a/server/src/routes/system.js b/server/src/routes/system.js
new file mode 100644
index 0000000..7a9fc19
--- /dev/null
+++ b/server/src/routes/system.js
@@ -0,0 +1,80 @@
+import { Router } from 'express';
+import fs from 'node:fs';
+import path from 'node:path';
+import { get, all, run, db, getSetting, setSetting } from '../db/index.js';
+import { ah, bad, notFound, str, int, num, flag, oneOf, paginate } from '../utils/http.js';
+import { authenticate, requireRole } from '../middleware/auth.js';
+import { audit } from '../utils/audit.js';
+import { config } from '../config.js';
+import { JOBS, runJob, jobStatus } from '../jobs/index.js';
+
+const r = Router();
+r.use(authenticate);
+
+// ---- settings
+const KEYS = ['school_name', 'school_address', 'school_phone', 'currency', 'academic_year', 'late_fee_percent', 'reminder_days_before', 'fiscal_start_month'];
+r.get('/settings', ah((_req, res) => res.json(Object.fromEntries(all('SELECT key, value FROM settings').map((x) => [x.key, x.value])))));
+r.put('/settings', requireRole('admin'), ah((req, res) => {
+  for (const k of KEYS) if (req.body[k] !== undefined) {
+    if (['late_fee_percent', 'reminder_days_before', 'fiscal_start_month'].includes(k)) num(req.body[k], k, { min: 0, max: 100 });
+    setSetting(k, str(req.body[k], k, { required: false, max: 200 }) ?? '');
+  }
+  audit(req, 'update_settings', 'settings'); res.json({ ok: true });
+}));
+
+// ---- ID card templates
+r.get('/id-templates', ah((_req, res) => res.json({ rows: all('SELECT * FROM id_templates ORDER BY is_default DESC, id') })));
+const color = (v, n) => { if (!/^#[0-9a-fA-F]{6}$/.test(String(v))) throw bad(`${n} must be a hex colour like #4f46e5`); return v; };
+function tplBody(b) {
+  return [str(b.name, 'Name', { max: 50 }), oneOf(b.orientation || 'portrait', ['portrait', 'landscape'], 'orientation'), color(b.primary_color || '#4f46e5', 'Primary colour'), color(b.accent_color || '#f59e0b', 'Accent colour'),
+    flag(b.show_blood_group), flag(b.show_address), flag(b.show_guardian), str(b.footer_text, 'Footer', { required: false, max: 120 })];
+}
+r.post('/id-templates', requireRole('admin'), ah((req, res) => {
+  const id = run('INSERT INTO id_templates(name, orientation, primary_color, accent_color, show_blood_group, show_address, show_guardian, footer_text) VALUES (?,?,?,?,?,?,?,?)', ...tplBody(req.body)).lastInsertRowid;
+  if (flag(req.body.is_default)) run('UPDATE id_templates SET is_default = 1 WHERE id = ?', id);
+  res.status(201).json({ id });
+}));
+r.put('/id-templates/:id', requireRole('admin'), ah((req, res) => {
+  const ex = get('SELECT * FROM id_templates WHERE id = ?', req.params.id); if (!ex) throw notFound();
+  run('UPDATE id_templates SET name=?, orientation=?, primary_color=?, accent_color=?, show_blood_group=?, show_address=?, show_guardian=?, footer_text=? WHERE id=?', ...tplBody({ ...ex, ...req.body }), ex.id);
+  if (flag(req.body.is_default)) run('UPDATE id_templates SET is_default = 1 WHERE id = ?', ex.id);
+  res.json({ ok: true });
+}));
+r.delete('/id-templates/:id', requireRole('admin'), ah((req, res) => {
+  if (get('SELECT COUNT(*) n FROM id_templates').n <= 1) throw bad('Keep at least one template');
+  run('DELETE FROM id_templates WHERE id = ?', req.params.id); res.json({ ok: true });
+}));
+
+// ---- audit trail
+r.get('/audit', requireRole('admin'), ah((req, res) => {
+  const { limit, offset } = paginate(req, { max: 200, def: 50 });
+  const where = []; const p = [];
+  if (req.query.q) { where.push('(action LIKE ? OR user_name LIKE ? OR entity LIKE ? OR details LIKE ?)'); const l = `%${req.query.q}%`; p.push(l, l, l, l); }
+  if (req.query.entity) { where.push('entity = ?'); p.push(req.query.entity); }
+  const w = where.length ? `WHERE ${where.join(' AND ')}` : '';
+  res.json({ rows: all(`SELECT * FROM audit_log ${w} ORDER BY id DESC LIMIT ? OFFSET ?`, ...p, limit, offset), total: get(`SELECT COUNT(*) n FROM audit_log ${w}`, ...p).n });
+}));
+
+// ---- scheduled jobs (cron)
+r.get('/jobs', requireRole('admin'), ah((_req, res) => res.json({ rows: jobStatus(), cron_enabled: config.enableCron })));
+r.post('/jobs/:name/run', requireRole('admin'), ah(async (req, res) => {
+  if (!JOBS[req.params.name]) throw notFound('Unknown job');
+  const out = await runJob(req.params.name, 'manual');
+  audit(req, 'run_job', 'job', req.params.name); res.json(out);
+}));
+r.get('/outbox', requireRole('admin'), ah((_req, res) => res.json({ rows: all('SELECT * FROM outbox ORDER BY id DESC LIMIT 100') })));
+
+// ---- database backups
+r.get('/backups', requireRole('admin'), ah((_req, res) => {
+  fs.mkdirSync(config.backupDir, { recursive: true });
+  res.json({ rows: fs.readdirSync(config.backupDir).filter((f) => f.endsWith('.db')).sort().reverse().map((f) => ({ name: f, size: fs.statSync(path.join(config.backupDir, f)).size })) });
+}));
+r.post('/backups', requireRole('admin'), ah(async (req, res) => {
+  const out = await runJob('db-backup', 'manual'); audit(req, 'backup_db', 'backup'); res.json(out);
+}));
+r.get('/backups/:name', requireRole('admin'), ah((req, res) => {
+  const f = path.join(config.backupDir, path.basename(req.params.name));
+  if (!f.endsWith('.db') || !fs.existsSync(f)) throw notFound(); res.download(f);
+}));
+
+export default r;
diff --git a/server/src/routes/transport.js b/server/src/routes/transport.js
new file mode 100644
index 0000000..826cb0d
--- /dev/null
+++ b/server/src/routes/transport.js
@@ -0,0 +1,184 @@
+import { Router } from 'express';
+import { get, all, run, tx } from '../db/index.js';
+import { ah, bad, notFound, forbidden, conflict, str, int, num, date, oneOf } from '../utils/http.js';
+import { authenticate, requireRole } from '../middleware/auth.js';
+import { audit } from '../utils/audit.js';
+import { notify, parentIdsOf } from '../utils/notify.js';
+import { childIds, driverVehicle, studentAccess } from '../utils/access.js';
+import { haversine } from '../utils/geo.js';
+
+const r = Router();
+r.use(authenticate);
+const admin = requireRole('admin');
+
+// Stops we already announced for a running trip: tripId -> Set(stopId)
+const announced = new Map();
+
+// ----------------------------------------------------------------- vehicles
+const VEH = `SELECT v.*, d.name AS driver_name, d.mobile AS driver_mobile, d.license_no, d.license_expiry, d.user_id AS driver_user_id,
+   cd.name AS co_driver_name, cd.mobile AS co_driver_mobile,
+   (SELECT r.name FROM routes r WHERE r.vehicle_id = v.id LIMIT 1) AS route_name,
+   (SELECT COUNT(*) FROM trips t WHERE t.vehicle_id = v.id AND t.status = 'running') AS running
+   FROM vehicles v LEFT JOIN employees d ON d.id = v.driver_employee_id LEFT JOIN employees cd ON cd.id = v.co_driver_employee_id`;
+
+r.get('/vehicles', requireRole('admin', 'finance'), ah((_req, res) => res.json({ rows: all(`${VEH} ORDER BY v.reg_no`) })));
+function vehBody(b) {
+  const d = int(b.driver_employee_id || null, 'driver', { required: false }), cd = int(b.co_driver_employee_id || null, 'co-driver', { required: false });
+  if (d && !get("SELECT 1 x FROM employees WHERE id = ? AND type = 'driver'", d)) throw bad('Selected driver is not a driver employee');
+  if (cd && !get("SELECT 1 x FROM employees WHERE id = ? AND type = 'co_driver'", cd)) throw bad('Selected co-driver is not a co-driver employee');
+  return [str(b.reg_no, 'Registration no', { max: 20 }).toUpperCase(), str(b.model, 'Model', { required: false, max: 60 }), int(b.capacity ?? 40, 'Capacity', { min: 1, max: 100 }),
+    date(b.insurance_expiry || null, 'insurance expiry', { required: false }), date(b.fitness_expiry || null, 'fitness expiry', { required: false }), d, cd, oneOf(b.status || 'active', ['active', 'maintenance', 'inactive'], 'status')];
+}
+r.post('/vehicles', admin, ah((req, res) => {
+  const id = run('INSERT INTO vehicles(reg_no, model, capacity, insurance_expiry, fitness_expiry, driver_employee_id, co_driver_employee_id, status) VALUES (?,?,?,?,?,?,?,?)', ...vehBody(req.body)).lastInsertRowid;
+  audit(req, 'create_vehicle', 'vehicle', id); res.status(201).json({ id });
+}));
+r.put('/vehicles/:id', admin, ah((req, res) => {
+  const ex = get('SELECT * FROM vehicles WHERE id = ?', req.params.id); if (!ex) throw notFound();
+  run('UPDATE vehicles SET reg_no=?, model=?, capacity=?, insurance_expiry=?, fitness_expiry=?, driver_employee_id=?, co_driver_employee_id=?, status=? WHERE id=?', ...vehBody({ ...ex, ...req.body }), ex.id);
+  audit(req, 'update_vehicle', 'vehicle', ex.id); res.json({ ok: true });
+}));
+r.delete('/vehicles/:id', admin, ah((req, res) => {
+  if (get('SELECT 1 x FROM trips WHERE vehicle_id = ?', req.params.id)) throw conflict('This vehicle has trip history. Mark it inactive instead.');
+  run('DELETE FROM vehicles WHERE id = ?', req.params.id); res.json({ ok: true });
+}));
+
+// ------------------------------------------------------------------- routes
+r.get('/routes', requireRole('admin', 'finance', 'teacher'), ah((_req, res) => {
+  const rows = all(`SELECT r.*, v.reg_no, d.name AS driver_name, (SELECT COUNT(*) FROM student_transport st WHERE st.route_id = r.id) AS riders
+    FROM routes r LEFT JOIN vehicles v ON v.id = r.vehicle_id LEFT JOIN employees d ON d.id = v.driver_employee_id ORDER BY r.name`);
+  for (const x of rows) x.stops = all('SELECT * FROM route_stops WHERE route_id = ? ORDER BY seq', x.id);
+  res.json({ rows });
+}));
+r.post('/routes', admin, ah((req, res) => {
+  const b = req.body;
+  const id = tx(() => {
+    const rid = run('INSERT INTO routes(name, via, vehicle_id, start_time, end_time, fare) VALUES (?,?,?,?,?,?)', str(b.name, 'Route name', { max: 80 }), str(b.via, 'Via details', { required: false, max: 300 }),
+      int(b.vehicle_id || null, 'vehicle', { required: false }), str(b.start_time, 'start', { required: false, max: 5 }), str(b.end_time, 'end', { required: false, max: 5 }), num(b.fare ?? 0, 'Fare', { min: 0 })).lastInsertRowid;
+    (b.stops || []).forEach((s, i) => run('INSERT INTO route_stops(route_id, name, lat, lng, seq, pickup_time) VALUES (?,?,?,?,?,?)', rid, str(s.name, 'Stop name', { max: 80 }), num(s.lat ?? null, 'lat', { required: false, min: -90, max: 90 }), num(s.lng ?? null, 'lng', { required: false, min: -180, max: 180 }), i + 1, s.pickup_time || null));
+    return rid;
+  });
+  audit(req, 'create_route', 'route', id); res.status(201).json({ id });
+}));
+r.put('/routes/:id', admin, ah((req, res) => {
+  const ex = get('SELECT * FROM routes WHERE id = ?', req.params.id); if (!ex) throw notFound();
+  const b = { ...ex, ...req.body };
+  tx(() => {
+    run('UPDATE routes SET name=?, via=?, vehicle_id=?, start_time=?, end_time=?, fare=? WHERE id=?', str(b.name, 'Route name', { max: 80 }), str(b.via, 'Via', { required: false, max: 300 }), int(b.vehicle_id || null, 'vehicle', { required: false }), b.start_time || null, b.end_time || null, num(b.fare ?? 0, 'Fare', { min: 0 }), ex.id);
+    if (Array.isArray(req.body.stops)) {
