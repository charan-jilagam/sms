+import { useState } from 'react';
+import { Plus, Pin, Trash2, Megaphone, CalendarDays, PartyPopper, Palmtree, FileText, ChevronLeft, ChevronRight } from 'lucide-react';
+import { api } from '../lib/api.js';
+import { useAuth } from '../lib/auth.jsx';
+import { useFetch } from '../lib/hooks.js';
+import { Badge, Button, Card, Empty, FormModal, Input, Loading, PageHead, Select, Tabs, Textarea, useConfirm, useToast } from '../components/ui.jsx';
+import { fdate, today, cap } from '../lib/format.js';
+
+const KIND = { notice: [Megaphone, 'info'], event: [PartyPopper, 'ok'], holiday: [Palmtree, 'warn'], circular: [FileText, 'gray'] };
+
+function Calendar() {
+  const [m, setM] = useState(today().slice(0, 7)); const { data, loading } = useFetch(`/calendar?month=${m}`, [m]);
+  const [y, mo] = m.split('-').map(Number); const first = new Date(y, mo - 1, 1); const days = new Date(y, mo, 0).getDate(); const off = (first.getDay() + 6) % 7;
+  const shift = (n) => { const d = new Date(y, mo - 1 + n, 1); setM(`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`); };
+  const cells = [...Array(off).fill(null), ...Array.from({ length: days }, (_, i) => i + 1)];
+  const on = (d) => { const ds = `${m}-${String(d).padStart(2, '0')}`; return (data?.rows || []).filter((e) => e.start_date <= ds && (e.end_date || e.start_date) >= ds); };
+  return <Card title={first.toLocaleDateString('en-IN', { month: 'long', year: 'numeric' })} action={<div className="row"><Button size="sm" icon={ChevronLeft} onClick={() => shift(-1)} /><Button size="sm" onClick={() => setM(today().slice(0, 7))}>Today</Button><Button size="sm" icon={ChevronRight} onClick={() => shift(1)} /></div>}>
+    {loading && !data ? <Loading /> : <div className="cal">{['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((d) => <div key={d} className="cal-h">{d}</div>)}{cells.map((d, i) => <div key={i} className={`cal-c ${d && `${m}-${String(d).padStart(2, '0')}` === today() ? 'today' : ''} ${d ? '' : 'blank'}`}>{d && <><span className="cal-d">{d}</span>{on(d).slice(0, 3).map((e) => <div key={e.id} className={`cal-e ${e.kind}`} title={e.title}>{e.title}</div>)}</>}</div>)}</div>}</Card>;
+}
+
+export default function Notices() {
+  const { user } = useAuth(); const toast = useToast(); const [ask, node] = useConfirm(); const [tab, setTab] = useState('feed'); const [kind, setKind] = useState('');
+  const staff = user.role === 'admin' || user.role === 'teacher'; const { data, loading, reload } = useFetch(`/announcements${kind ? `?kind=${kind}` : ''}`, [kind]);
+  const classes = useFetch(staff ? `/classes${user.role === 'teacher' ? '?mine=1' : ''}` : null); const [form, setForm] = useState(null);
+  const C = classes.data?.rows || [];
+  return (
+    <>
+      <PageHead title="Notices & events" sub="Announcements, holidays, circulars and the school calendar">{staff && <Button variant="primary" icon={Plus} onClick={() => setForm({ kind: 'notice', title: '', body: '', audience: user.role === 'teacher' ? 'class' : 'all', class_id: C[0]?.id || '', start_date: today(), end_date: '', pinned: false })}>Post</Button>}</PageHead>
+      <div style={{ marginBottom: 16 }}><Tabs value={tab} onChange={setTab} tabs={[{ id: 'feed', label: 'Feed' }, { id: 'calendar', label: 'Calendar' }]} /></div>
+      {tab === 'calendar' ? <Calendar /> : <>
+        <div className="row" style={{ marginBottom: 14 }}>{['', 'notice', 'event', 'holiday', 'circular'].map((k) => <button key={k} className={`chip ${kind === k ? 'on' : ''}`} onClick={() => setKind(k)}>{k ? cap(k) : 'All'}</button>)}</div>
+        {loading ? <Loading /> : !data?.rows.length ? <Card><Empty title="No announcements" icon={Megaphone} /></Card> : <div className="stack">{data.rows.map((a) => { const [I, tone] = KIND[a.kind]; return <Card key={a.id}><div className="row" style={{ alignItems: 'flex-start', gap: 14 }}><div className={`ico b-${tone}`}><I size={20} /></div><div style={{ flex: 1 }}>
+          <div className="row between"><div className="row"><b style={{ fontSize: 16 }}>{a.title}</b>{a.pinned ? <Pin size={14} color="var(--brand)" /> : null}<Badge tone={tone}>{cap(a.kind)}</Badge>{a.audience !== 'all' && <Badge>{a.audience === 'class' ? `Class ${a.class_label}` : cap(a.audience)}</Badge>}</div>{staff && (user.role === 'admin' || a.created_by === user.id) && <Button size="sm" variant="danger" icon={Trash2} onClick={async () => { if (await ask({ message: 'Delete this announcement?', danger: true, confirm: 'Delete' })) { await api.del(`/announcements/${a.id}`); reload(); } }} />}</div>
+          <div className="muted small" style={{ margin: '4px 0 8px' }}><CalendarDays size={12} /> {fdate(a.start_date)}{a.end_date && a.end_date !== a.start_date ? ` – ${fdate(a.end_date)}` : ''} · {a.author}</div>{a.body && <p style={{ margin: 0, whiteSpace: 'pre-wrap' }}>{a.body}</p>}</div></div></Card>; })}</div>}</>}
+      {form && <FormModal title="Post an announcement" submitLabel="Post & notify" onClose={() => setForm(null)} onSubmit={async () => { const r = await api.post('/announcements', { ...form, class_id: form.audience === 'class' ? form.class_id : null }); setForm(null); reload(); toast(`Posted. ${r.notified} people notified`); }}>
+        <div className="form-grid"><Select label="Type" value={form.kind} onChange={(v) => setForm({ ...form, kind: v })} options={['notice', 'event', 'holiday', 'circular']} />
+          {user.role === 'admin' ? <Select label="Audience" value={form.audience} onChange={(v) => setForm({ ...form, audience: v })} options={[{ value: 'all', label: 'Everyone' }, { value: 'parents', label: 'Parents' }, { value: 'students', label: 'Students' }, { value: 'staff', label: 'Staff' }, { value: 'drivers', label: 'Drivers' }, { value: 'class', label: 'One class' }]} /> : <Input label="Audience" value="Your class" disabled />}
+          {form.audience === 'class' && <Select full label="Class" value={form.class_id} onChange={(v) => setForm({ ...form, class_id: v })} options={C.map((c) => ({ value: c.id, label: c.label }))} />}
+          <Input full label="Title *" value={form.title} onChange={(v) => setForm({ ...form, title: v })} required /><Textarea full label="Details" value={form.body} onChange={(v) => setForm({ ...form, body: v })} rows={4} /><Input label="Starts" type="date" value={form.start_date} onChange={(v) => setForm({ ...form, start_date: v })} /><Input label="Ends (optional)" type="date" value={form.end_date} onChange={(v) => setForm({ ...form, end_date: v })} />
+          {user.role === 'admin' && <label className="row full"><input type="checkbox" checked={form.pinned} onChange={(e) => setForm({ ...form, pinned: e.target.checked })} /> Pin to the top</label>}</div></FormModal>}
+      {node}
+    </>
+  );
+}
diff --git a/client/src/pages/Notifications.jsx b/client/src/pages/Notifications.jsx
new file mode 100644
index 0000000..55a947a
--- /dev/null
+++ b/client/src/pages/Notifications.jsx
@@ -0,0 +1,19 @@
+import { useNavigate } from 'react-router-dom';
+import { Bell, CheckCheck } from 'lucide-react';
+import { api } from '../lib/api.js';
+import { useFetch } from '../lib/hooks.js';
+import { useAuth } from '../lib/auth.jsx';
+import { ago, cap } from '../lib/format.js';
+import { Badge, Button, Card, Empty, Loading, PageHead } from '../components/ui.jsx';
+
+export default function Notifications() {
+  const { data, loading, reload } = useFetch('/notifications'); const nav = useNavigate(); const { refreshUnread } = useAuth();
+  const open = async (n) => { if (!n.is_read) { await api.post('/notifications/read', { ids: [n.id] }); refreshUnread(); } if (n.link) nav(n.link); else reload(); };
+  return (
+    <>
+      <PageHead title="Notifications" sub="Fee reminders, leave decisions, bus alerts and school updates"><Button icon={CheckCheck} onClick={async () => { await api.post('/notifications/read', { all: true }); reload(); refreshUnread(); }}>Mark all read</Button></PageHead>
+      <Card pad={false}>{loading ? <div className="card-b"><Loading /></div> : !data?.rows.length ? <Empty title="No notifications" icon={Bell} /> :
+        data.rows.map((n) => <div key={n.id} className={`notif ${n.is_read ? '' : 'unread'}`} onClick={() => open(n)}><span className="dot" style={{ marginTop: 7, opacity: n.is_read ? 0 : 1 }} /><div className="grow"><b>{n.title}</b>{n.body && <div className="muted">{n.body}</div>}<div className="muted small">{ago(n.created_at)}</div></div><Badge>{cap(n.kind)}</Badge></div>)}</Card>
+    </>
+  );
+}
diff --git a/client/src/pages/Papers.jsx b/client/src/pages/Papers.jsx
new file mode 100644
index 0000000..a813424
--- /dev/null
+++ b/client/src/pages/Papers.jsx
@@ -0,0 +1,44 @@
+import { useRef, useState } from 'react';
+import { Upload, Download, Eye, EyeOff, Trash2, FileText } from 'lucide-react';
+import { api } from '../lib/api.js';
+import { useAuth } from '../lib/auth.jsx';
+import { useFetch } from '../lib/hooks.js';
+import { Alert, Badge, Button, Card, FormModal, Input, PageHead, Select, Table, useConfirm, useToast } from '../components/ui.jsx';
+import { fdate, fdatetime } from '../lib/format.js';
+
+function Upload_({ classes, subjects, onClose, onDone }) {
+  const [f, setF] = useState({ title: '', class_id: classes[0]?.id || '', subject_id: '', visible: false, release_at: '' }); const file = useRef(null); const set = (k) => (v) => setF((x) => ({ ...x, [k]: v }));
+  return <FormModal title="Upload question paper" onClose={onClose} submitLabel="Upload" onSubmit={async () => {
+    const fl = file.current?.files?.[0]; if (!fl) throw new Error('Please choose a file');
+    const fd = new FormData(); fd.append('file', fl); fd.append('title', f.title); fd.append('class_id', f.class_id); if (f.subject_id) fd.append('subject_id', f.subject_id); fd.append('visible_to_students', f.visible ? '1' : '0'); if (f.release_at) fd.append('release_at', f.release_at.replace('T', ' ') + ':00');
+    await api.upload('/papers', fd); onDone();
+  }}>
+    <Alert>Papers stay private to teachers until you release them to students.</Alert>
+    <div className="form-grid"><Input full label="Title *" value={f.title} onChange={set('title')} placeholder="e.g. Science - Mid Term paper" required />
+      <Select label="Class *" value={f.class_id} onChange={set('class_id')} options={classes.map((c) => ({ value: c.id, label: c.label }))} />
+      <Select label="Subject" value={f.subject_id} onChange={set('subject_id')} placeholder="General" options={subjects.map((s) => ({ value: s.id, label: s.name }))} />
+      <div className="field full"><label>File * (PDF, Word, image - max 10 MB)</label><input ref={file} className="input" type="file" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.ppt,.pptx,.txt" /></div>
+      <label className="row full"><input type="checkbox" checked={f.visible} onChange={(e) => set('visible')(e.target.checked)} /> Release to students now</label>
+      {f.visible && <Input full type="datetime-local" label="Or release automatically at (optional)" value={f.release_at} onChange={set('release_at')} />}</div>
+  </FormModal>;
+}
+
+export default function Papers() {
+  const { user } = useAuth(); const toast = useToast(); const [ask, node] = useConfirm(); const [up, setUp] = useState(false);
+  const staff = user.role === 'admin' || user.role === 'teacher';
+  const { data, loading, reload } = useFetch('/papers'); const classes = useFetch(staff ? '/classes' + (user.role === 'teacher' ? '?mine=1' : '') : null); const subjects = useFetch(staff ? '/subjects' : null);
+  const released = (p) => p.visible_to_students && (!p.release_at || p.release_at <= new Date().toISOString().replace('T', ' ').slice(0, 19));
+  return (
+    <>
+      <PageHead title="Question papers" sub={staff ? 'Upload papers, keep them private, and release them to students when the time comes' : 'Question papers shared by your teachers'}>{staff && <Button variant="primary" icon={Upload} onClick={() => setUp(true)}>Upload paper</Button>}</PageHead>
+      <Card pad={false}><Table loading={loading} rows={data?.rows} empty="No question papers" columns={[
+        { title: 'Paper', render: (p) => <div className="row" style={{ gap: 12 }}><FileText color="var(--brand)" /><div><b>{p.title}</b><div className="muted small">{p.file_name}</div></div></div> }, { title: 'Class', key: 'class_label' }, { title: 'Subject', render: (p) => p.subject || '-' }, { title: 'Uploaded', render: (p) => <div>{fdate(p.created_at)}<div className="muted small">{p.uploaded_by_name}</div></div> },
+        ...(staff ? [{ title: 'Visibility', render: (p) => released(p) ? <Badge tone="ok">Released</Badge> : p.release_at ? <Badge tone="info">Scheduled {fdatetime(p.release_at)}</Badge> : <Badge tone="gray">Private</Badge> }] : []),
+        { title: '', render: (p) => <div className="row end"><Button size="sm" icon={Download} onClick={() => api.download(`/papers/${p.id}/download`, p.file_name).catch((e) => toast(e.message, 'bad'))}>Download</Button>
+          {staff && <Button size="sm" icon={released(p) ? EyeOff : Eye} onClick={async () => { await api.post(`/papers/${p.id}/release`, { visible: released(p) ? 0 : 1 }); toast(released(p) ? 'Hidden from students' : 'Released to students'); reload(); }}>{released(p) ? 'Hide' : 'Release'}</Button>}
+          {staff && <Button size="sm" variant="danger" icon={Trash2} onClick={async () => { if (await ask({ message: `Delete "${p.title}"?`, danger: true, confirm: 'Delete' })) { await api.del(`/papers/${p.id}`); reload(); } }} />}</div> }]} /></Card>
+      {up && <Upload_ classes={classes.data?.rows || []} subjects={subjects.data?.rows || []} onClose={() => setUp(false)} onDone={() => { setUp(false); reload(); toast('Uploaded'); }} />}
+      {node}
+    </>
+  );
+}
diff --git a/client/src/pages/Profile.jsx b/client/src/pages/Profile.jsx
new file mode 100644
index 0000000..c9e6dc7
--- /dev/null
+++ b/client/src/pages/Profile.jsx
@@ -0,0 +1,34 @@
+import { useState } from 'react';
+import { useAuth } from '../lib/auth.jsx';
+import { api, setToken } from '../lib/api.js';
+import { ROLE_LABEL } from '../lib/format.js';
+import { Alert, Avatar, Button, Card, Input, PageHead, useToast } from '../components/ui.jsx';
+
+export default function Profile({ forced }) {
+  const { user, setUser } = useAuth(); const toast = useToast();
+  const [f, setF] = useState({ current_password: '', new_password: '', confirm: '' }); const [busy, setBusy] = useState(false); const [err, setErr] = useState('');
+  const set = (k) => (v) => setF((x) => ({ ...x, [k]: v }));
+  const save = async (e) => {
+    e.preventDefault(); setErr('');
+    if (f.new_password !== f.confirm) return setErr('The new passwords do not match');
+    setBusy(true);
+    try { const r = await api.post('/auth/change-password', { current_password: f.current_password, new_password: f.new_password }); setToken(r.token); setUser(r.user); toast('Password updated'); setF({ current_password: '', new_password: '', confirm: '' }); }
+    catch (x) { setErr(x.message); } finally { setBusy(false); }
+  };
+  return (
+    <>
+      <PageHead title={forced ? 'Set a new password' : 'Profile & password'} sub={forced ? 'For your security, please replace the temporary password before continuing.' : undefined} />
+      <div className="grid g2">
+        <Card title="Account"><div className="row" style={{ gap: 16 }}><Avatar name={user.name} size="lg" /><div><h3>{user.name}</h3><div className="muted">{ROLE_LABEL[user.role]}</div><div className="muted small">{user.email || user.mobile}</div></div></div></Card>
+        <Card title="Change password">
+          <form className="stack" onSubmit={save}>{forced && <Alert tone="warn">You are signed in with a temporary password.</Alert>}{err && <Alert tone="bad">{err}</Alert>}
+            <Input label="Current password" type="password" value={f.current_password} onChange={set('current_password')} required autoComplete="current-password" />
+            <Input label="New password" type="password" hint="At least 8 characters" value={f.new_password} onChange={set('new_password')} minLength={8} required autoComplete="new-password" />
+            <Input label="Confirm new password" type="password" value={f.confirm} onChange={set('confirm')} required autoComplete="new-password" />
+            <Button variant="primary" type="submit" loading={busy}>Update password</Button>
+          </form>
+        </Card>
+      </div>
+    </>
+  );
+}
diff --git a/client/src/pages/Reports.jsx b/client/src/pages/Reports.jsx
