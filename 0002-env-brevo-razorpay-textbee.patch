@@ -0,0 +1,43 @@
+import { all, run, getSetting } from '../db/index.js';
+import { config } from '../config.js';
+
+/**
+ * Delivers queued outbox rows.
+ *  - e-mail through Brevo (BREVO_API_KEY + EMAIL_FROM)
+ *  - SMS through TextBee (TEXTBEE_API_KEY + TEXTBEE_DEVICE_ID)
