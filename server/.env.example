# Copy to .env  (the server reads real environment variables; use `export` or a process manager)
PORT=4000
NODE_ENV=development
# REQUIRED in production: long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# SQLite file (use :memory: for tests)
DB_PATH=./data/school.db
UPLOAD_DIR=./uploads
BACKUP_DIR=./data/backups
# Origin(s) of the React app, comma separated
CORS_ORIGIN=http://localhost:5173
# Payment provider: "mock" (built-in simulator). Add real adapters in src/utils/gateway.js
PAYMENT_PROVIDER=mock
# Set to 0 to disable background jobs
ENABLE_CRON=1
