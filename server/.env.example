# Copy this file to server/.env and fill in your values. server/.env is git-ignored.
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173

DB_PATH=./data/school.db
UPLOAD_DIR=./uploads
BACKUP_DIR=./data/backups

# Scheduler is OFF by default. Set to 1 to run the automatic jobs.
ENABLE_CRON=0

# E-mail through Brevo (https://app.brevo.com > SMTP & API > API keys)
BREVO_API_KEY=
EMAIL_FROM=you@example.com

# Online fees through Razorpay (leave empty to use the demo gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMS through TextBee (https://textbee.dev). Needs the device id of your registered phone.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
SMS_DEFAULT_COUNTRY_CODE=+91
